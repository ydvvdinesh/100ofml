    ax.set_ylabel(\n        \"Residual\"\n    )\n\n    ax.grid(\n        alpha=0.2\n    )\n\n\naxes[-1].axis(\n    \"off\"\n)\n\n\nplt.suptitle(\n    \"Residual Analysis\",\n    fontsize=16\n)\n\nplt.tight_layout()\n\nplt.show()\n\n\n# ============================================================\n# 15.15 — ABSOLUTE ERROR DISTRIBUTION\n# ============================================================\n# Absolute error:\n#\n#     |actual - predicted|\n#\n# This shows how prediction errors are distributed.\n\nplt.figure(\n    figsize=(12, 7)\n)\n\n\nfor model_name in models:\n\n    errors = np.abs(\n        residuals[model_name]\n    )\n\n    plt.hist(\n        errors,\n        bins=30,\n        alpha=0.35,\n        label=model_name\n    )\n\n\nplt.xlabel(\n    \"Absolute Prediction Error\"\n)\n\nplt.ylabel(\n    \"Frequency\"\n)\n\nplt.title(\n    \"Absolute Error Distribution\"\n)\n\nplt.legend()\n\nplt.grid(\n    alpha=0.2\n)\n\nplt.show()\n\n\n# ============================================================\n# 15.16 — FINAL TEST METRIC COMPARISON\n# ============================================================\n# These are the metrics from the same held-out test set.\n#\n# MAE:\n#     Typical absolute error.\n#\n# RMSE:\n#     More sensitive to large errors.\n#\n# R²:\n#     Explained variance relative to the mean baseline.\n\nfinal_test_comparison = performance_df[\n    [\n        \"Model\",\n        \"Test MAE\",\n        \"Test RMSE\",\n        \"Test R²\"\n    ]\n].copy()\n\n\nprint(\"\\n15.16 — FINAL TEST METRIC COMPARISON\")\nprint(\"=\" * 90)\n\n\ndisplay(\n    final_test_comparison.style.format({\n\n        \"Test MAE\":\n            \"₹{:,.2f}\",\n\n        \"Test RMSE\":\n            \"₹{:,.2f}\",\n\n        \"Test R²\":\n            \"{:.6f}\"\n    })\n)\n\n\n# ============================================================\n# 15.17 — MODEL COMPLEXITY\n# ============================================================\n# We inspect the structure of each model.\n#\n# This connects numerical performance with model complexity.\n\nprint(\"\\n15.17 — MODEL STRUCTURE\")\nprint(\"=\" * 80)\n\n\nprint(\"\\nLinear Regression\")\n\nprint(\n    f\"Number of coefficients: \"\n    f\"{len(linear_model_final.coef_)}\"\n)\n\n\nprint(\"\\nDecision Tree\")\n\nprint(\n    f\"Tree depth: \"\n    f\"{tree_model_final.get_depth()}\"\n)\n\nprint(\n    f\"Leaf count: \"\n    f\"{tree_model_final.get_n_leaves()}\"\n)\n\n\nprint(\"\\nRandom Forest\")\n\nprint(\n    f\"Number of trees: \"\n    f\"{len(rf_model_final.estimators_)}\"\n)\n\n\nprint(\"\\nGradient Boosting\")\n\nprint(\n    f\"Number of trees: \"\n    f\"{gb_model_final.n_estimators}\"\n)\n\nprint(\n    f\"Learning rate: \"\n    f\"{gb_model_final.learning_rate}\"\n)\n\nprint(\n    f\"Tree depth: \"\n    f\"{gb_model_final.max_depth}\"\n)\n\n\nprint(\"\\nXGBoost\")\n\nprint(\n    f\"Number of trees: \"\n    f\"{xgb_model_final.n_estimators}\"\n)\n\nprint(\n    f\"Learning rate: \"\n    f\"{xgb_model_final.learning_rate}\"\n)\n\nprint(\n    f\"Tree depth: \"\n    f\"{xgb_model_final.max_depth}\"\n)\n\nprint(\n    f\"Subsample: \"\n    f\"{xgb_model_final.subsample}\"\n)\n\nprint(\n    f\"Feature sample: \"\n    f\"{xgb_model_final.colsample_bytree}\"\n)\n\n\n# ============================================================\n# 15.18 — XGBOOST ERROR ANALYSIS\n# ============================================================\n# We inspect the individual test examples with the largest\n# XGBoost errors.\n#\n# Aggregate metrics tell us HOW MUCH error exists.\n# Error analysis helps us understand WHERE the model fails.\n\nxgb_error_analysis = pd.DataFrame({\n\n    \"Actual Price\":\n        y_test.to_numpy(),\n\n    \"Predicted Price\":\n        predictions[\"XGBoost\"][\"test\"]\n})\n\n\nxgb_error_analysis[\"Residual\"] = (\n    xgb_error_analysis[\"Actual Price\"] -\n    xgb_error_analysis[\"Predicted Price\"]\n)\n\n\nxgb_error_analysis[\"Absolute Error\"] = (\n    xgb_error_analysis[\"Residual\"].abs()\n)\n\n\nxgb_error_analysis = (\n    xgb_error_analysis\n    .sort_values(\n        \"Absolute Error\",\n        ascending=False\n    )\n    .reset_index(drop=True)\n)\n\n\nprint(\"\\n15.18 — TOP 15 LARGEST XGBOOST ERRORS\")\nprint(\"=\" * 100)\n\n\ndisplay(\n    xgb_error_analysis.head(15).style.format({\n\n        \"Actual Price\":\n            \"₹{:,.2f}\",\n\n        \"Predicted Price\":\n            \"₹{:,.2f}\",\n\n        \"Residual\":\n            \"₹{:,.2f}\",\n\n        \"Absolute Error\":\n            \"₹{:,.2f}\"\n    })\n)\n\n\n# ============================================================\n# 15.19 — XGBOOST RELATIVE ERROR\n# ============================================================\n# Absolute percentage-style error:\n#\n#     |actual - predicted|\n#     -------------------- × 100\n#          |actual|\n#\n# This provides an additional perspective on prediction error.\n\nxgb_percentage_error = (\n\n    xgb_error_analysis[\"Absolute Error\"] /\n\n    np.maximum(\n        np.abs(\n            xgb_error_analysis[\"Actual Price\"]\n        ),\n        1e-8\n    )\n\n) * 100\n\n\nprint(\"\\n15.19 — XGBOOST RELATIVE ERROR\")\nprint(\"=\" * 75)\n\n\nprint(\n    \"Mean absolute percentage-style error: \"\n    f\"{xgb_percentage_error.mean():.2f}%\"\n)\n\n\nprint(\n    \"Median absolute percentage-style error: \"\n    f\"{xgb_percentage_error.median():.2f}%\"\n)\n\n\n# ============================================================\n# 15.20 — FINAL PROJECT SCORECARD\n# ============================================================\n# Compact final record of Project #1.\n#\n# We deliberately do not create a single arbitrary \"overall\n# score\", because MAE, RMSE and R² measure different properties.\n\nscorecard = final_test_comparison.copy()\n\n\nscorecard[\"Test MAE (Lakhs)\"] = (\n    scorecard[\"Test MAE\"] /\n    100000\n)\n\n\nscorecard[\"Test RMSE (Lakhs)\"] = (\n    scorecard[\"Test RMSE\"] /\n    100000\n)\n\n\nscorecard = scorecard[\n    [\n        \"Model\",\n        \"Test MAE\",\n        \"Test MAE (Lakhs)\",\n        \"Test RMSE\",\n        \"Test RMSE (Lakhs)\",\n        \"Test R²\"\n    ]\n]\n\n\nprint(\"\\n15.20 — PROJECT #1 FINAL SCORECARD\")\nprint(\"=\" * 105)\n\n\ndisplay(\n    scorecard.style.format({\n\n        \"Test MAE\":\n            \"₹{:,.2f}\",\n\n        \"Test MAE (Lakhs)\":\n            \"{:.3f}\",\n\n        \"Test RMSE\":\n            \"₹{:,.2f}\",\n\n        \"Test RMSE (Lakhs)\":\n            \"{:.3f}\",\n\n        \"Test R²\":\n            \"{:.6f}\"\n    })\n)\n\n\n# ============================================================\n# 15.21 — PROJECT #1 COMPLETION SUMMARY\n# ============================================================\n\nprint(\"\\n\" + \"=\" * 95)\nprint(\"STEP 15 COMPLETE — PROJECT #1 FINAL ANALYSIS\")\nprint(\"=\" * 95)\n\n\nprint(\"\"\"\nPROJECT #1 — HOUSE PRICE PREDICTION\n------------------------------------\n\nCompleted:\n\n1.  Problem Definition\n2.  Dataset Understanding\n3.  Exploratory Data Analysis\n4.  Feature Engineering & Preprocessing\n5.  Linear Regression\n6.  Regression Evaluation\n7.  Linear Regression From Scratch\n8.  Ridge & Lasso\n9.  Hyperparameter Tuning\n10. Decision Tree\n11. Random Forest\n12. Cross-Validation & Proper Hyperparameter Tuning\n13. Gradient Boosting\n14. XGBoost\n15. Final Model Analysis\n\nMajor concepts covered:\n\n• Supervised learning\n• Regression\n• Train/test splitting\n• Data leakage\n• One-hot encoding\n• Linear regression\n• Closed-form regression\n• Regularization\n• Decision trees\n• Bagging\n• Random forests\n• Boosting\n• Gradient boosting\n• XGBoost\n• Cross-validation\n• Hyperparameter tuning\n• GridSearchCV\n• RandomizedSearchCV\n• Bias and variance\n• Overfitting\n• Generalization\n• Residual analysis\n• Error analysis\n• Feature importance\n• Model complexity\n• Model selection\n\nPROJECT #1 IS COMPLETE.\n\"\"\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-02T13:26:35.983741Z","iopub.exec