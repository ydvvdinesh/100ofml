ge size of our prediction errors,\n# without considering whether the model overestimated or\n# underestimated the price.\n#\n# Formula:\n#\n# MAE = (1/n) × Σ |Actual - Predicted|\n#\n# y_test → actual prices\n# y_pred → model's predicted prices\nmae = mean_absolute_error(\n    y_test,\n    y_pred\n)\n\n\n# Display the MAE.\nprint(\"===== MEAN ABSOLUTE ERROR (MAE) =====\")\nprint(f\"MAE: ₹{mae:,.2f}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-02T12:44:27.885456Z","iopub.execute_input":"2026-10-02T12:44:27.885923Z","iopub.status.idle":"2026-10-02T12:44:27.892929Z","shell.execute_reply.started":"2026-10-02T12:44:27.885892Z","shell.execute_reply":"2026-10-02T12:44:27.892075Z"}},"outputs":[{"name":"stdout","text":"===== MEAN ABSOLUTE ERROR (MAE) =====\nMAE: ₹970,043.40\n","output_type":"stream"}],"execution_count":40},{"cell_type":"code","source":"# ============================================================\n# STEP 6 — MODEL EVALUATION\n# 6.2 — Calculate Mean Squared Error (MSE)\n# ============================================================\n\n# OBJECTIVE: Measure the average squared prediction error and\n# understand how strongly large prediction mistakes affect the model's score.\n\n\nfrom sklearn.metrics import mean_squared_error\n\n\n# Calculate Mean Squared Error.\n#\n# Formula:\n#\n# MSE = (1/n) × Σ(Actual - Predicted)²\n#\n# Squaring the errors means that large mistakes receive\n# much more penalty than small mistakes.\nmse = mean_squared_error(\n    y_test,\n    y_pred\n)\n\n\n# Display the MSE.\nprint(\"===== MEAN SQUARED ERROR (MSE) =====\")\nprint(f\"MSE: {mse:,.2f}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-02T12:44:37.313748Z","iopub.execute_input":"2026-10-02T12:44:37.314649Z","iopub.status.idle":"2026-10-02T12:44:37.3205Z","shell.execute_reply.started":"2026-10-02T12:44:37.314616Z","shell.execute_reply":"2026-10-02T12:44:37.319634Z"}},"outputs":[{"name":"stdout","text":"===== MEAN SQUARED ERROR 