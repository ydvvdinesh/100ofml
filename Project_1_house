],"execution_count":62},{"cell_type":"code","source":"# ============================================================\n# STEP 12 — CROSS-VALIDATION + PROPER HYPERPARAMETER TUNING\n# COMPLETE STEP\n# ============================================================\n\n# OBJECTIVE:\n# Learn and implement proper model selection using K-Fold\n# Cross-Validation instead of repeatedly tuning directly on\n# the test set.\n#\n# We will:\n#\n# 12.1  Import required libraries\n# 12.2  Verify required variables\n# 12.3  Understand train/validation/test separation\n# 12.4  Create K-Fold Cross-Validation\n# 12.5  Evaluate a baseline Random Forest using CV\n# 12.6  Understand CV scores\n# 12.7  Perform GridSearchCV\n# 12.8  Inspect all hyperparameter combinations\n# 12.9  Select the best CV configuration\n# 12.10 Retrain the best model on all training data\n# 12.11 Perform ONE final test evaluation\n# 12.12 Compare CV performance with test performance\n# 12.13 Compare Linear Regression, Decision Tree and\n#       properly tuned Random Forest\n#\n# IMPORTANT:\n#\n# The test set should NOT be used to choose hyperparameters.\n#\n# Correct workflow:\n#\n#             ORIGINAL DATA\n#                   |\n#                   v\n#             Train / Test Split\n#                   |\n#          +--------+--------+\n#          |                 |\n#        TRAIN              TEST\n#          |\n#          v\n#     K-Fold Cross-Validation\n#          |\n#          v\n#     Hyperparameter Tuning\n#          |\n#          v\n#     Best Hyperparameters\n#          |\n#          v\n#     Train on ALL training data\n#          |\n#          v\n#     ONE FINAL TEST\n#\n# This gives us a much cleaner estimate of generalization\n# performance.\n\n\n# ============================================================\n# 12.1 — IMPORT REQUIRED LIBRARIES\n# ============================================================\n\n# OBJECTIVE:\n# Import the tools required for K-Fold Cross-Validation and\n# GridSearchCV.\n\nimport numpy as np\nimport pandas as pd\nimport matplotlib.pyplot as plt\n\nfrom sklearn.ensemble import RandomForestRegressor\n\nfrom sklearn.model_selection import (\n    KFold,\n    cross_val_score,\n    GridSearchCV\n)\n\nfrom sklearn.metrics import (\n    mean_absolute_error,\n    mean_squared_error,\n    r2_score\n)\n\n\n# ============================================================\n# 12.2 — VERIFY REQUIRED VARIABLES\n# ============================================================\n\n# OBJECTIVE:\n# Verify that the processed training/test data and previous\n# model results are available.\n\nrequired_variables = [\n    \"X_train_processed\",\n    \"X_test_processed\",\n    \"y_train\",\n    \"y_test\",\n    \"feature_names\",\n    \"linear_mae\",\n    \"linear_rmse\",\n    \"linear_r2\",\n    \"selected_tree_mae\",\n    \"selected_tree_rmse\",\n    \"selected_tree_r2\"\n]\n\nmissing_variables = [\n    variable\n    for variable in required_variables\n    if variable not in globals()\n]\n\nif missing_variables:\n    raise NameError(\n        \"Missing variables: \"\n        + \", \".join(missing_variables)\n        + \". Please run previous steps first.\"\n    )\n\nprint(\"===== REQUIRED VARIABLES CHECK =====\")\nprint(\"All required variables are available.\")\n\n\n# ============================================================\n# 12.3 — UNDERSTAND THE TRAIN / TEST SETUP\n# ============================================================\n\n# OBJECTIVE:\n# Explicitly separate the training and test sets.\n#\n# The test set will NOT be used during hyperparameter tuning.\n#\n# Training set:\n#     Used for model training and cross-validation.\n#\n# Test set:\n#     Used only once at the end for final evaluation.\n\ncv_X_train = X_train_processed\ncv_y_train = y_train\n\nfinal_X_test = X_test_processed\nfinal_y_test = y_test\n\nprint(\"\\n===== DATA SPLIT =====\")\nprint(\"Training samples:\", cv_X_train.shape[0])\nprint(\"Testing samples:\", final_X_test.shape[0])\nprint(\"Number of features:\", cv_X_train.shape[1])\n\nprint(\"\\nThe test set will remain untouched during tuning.\")\n\n\n# ============================================================\n# 12.4 — CREATE 5-FOLD CROSS-VALIDATION\n# ============================================================\n\n# OBJECTIVE:\n# Create a 5-fold cross-validation strategy.\n#\n# K-Fold works by dividing the training data into K parts.\n#\n# For K=5:\n#\n# Fold 1:\n#     Train = folds 2,3,4,5\n#     Validate = fold 1\n#\n# Fold 2:\n#     Train = folds 1,3,4,5\n#     Validate = fold 2\n#\n# ...\n#\n# Every observation gets used for validation exactly once.\n#\n# shuffle=True:\n#     Randomly shuffles the observations before creating folds.\n#\n# random_state=42:\n#     Makes the folds reproducible.\n\nkfold = KFold(\n    n_splits=5,\n    shuffle=True,\n    random_state=42\n)\n\nprint(\"\\n===== 5-FOLD CROSS-VALIDATION =====\")\nprint(\"Number of folds:\", kfold.n_splits)\nprint(\"Shuffle:\", kfold.shuffle)\nprint(\"Random state:\", kfold.random_state)\n\n\n# ============================================================\n# 12.5 — BASELINE RANDOM FOREST WITH CROSS-VALIDATION\n# ============================================================\n\n# OBJECTIVE:\n# Establish a baseline CV performance before performing\n# hyperparameter tuning.\n#\n# scoring=\"neg_root_mean_squared_error\":\n#\n# sklearn's scoring API treats higher scores as better.\n#\n# Therefore RMSE is returned as a NEGATIVE value.\n#\n# We multiply by -1 to convert it back to normal RMSE.\n\nbaseline_rf = RandomForestRegressor(\n    n_estimators=200,\n    max_depth=6,\n    min_samples_split=2,\n    min_samples_leaf=1,\n    random_state=42,\n    n_jobs=-1\n)\n\nbaseline_cv_scores = cross_val_score(\n    baseline_rf,\n    cv_X_train,\n    cv_y_train,\n    cv=kfold,\n    scoring=\"neg_root_mean_squared_error\",\n    n_jobs=-1\n)\n\nbaseline_cv_rmse_scores = -baseline_cv_scores\n\nbaseline_cv_mean_rmse = (\n    baseline_cv_rmse_scores.mean()\n)\n\nbaseline_cv_std_rmse = (\n    baseline_cv_rmse_scores.std()\n)\n\nprint(\"\\n===== BASELINE RANDOM FOREST — 5-FOLD CV =====\")\n\nfor fold_number, score in enumerate(\n    baseline_cv_rmse_scores,\n    start=1\n):\n    print(\n        f\"Fold {fold_number} RMSE: \"\n        f\"₹{score:,.2f}\"\n    )\n\nprint(\n    f\"\\nMean CV RMSE: \"\n    f\"₹{baseline_cv_mean_rmse:,.2f}\"\n)\n\nprint(\n    f\"CV RMSE Std: \"\n    f\"₹{baseline_cv_std_rmse:,.2f}\"\n)\n\n\n# ============================================================\n# 12.6 — CALCULATE CV RMSE VARIABILITY\n# ============================================================\n\n# OBJECTIVE:\n# Understand how stable the model's performance is across\n# different validation folds.\n#\n# A smaller standard deviation means the model's performance\n# is more consistent across folds.\n\ncv_fold_summary = pd.DataFrame({\n    \"Fold\": range(\n        1,\n        len(baseline_cv_rmse_scores) + 1\n    ),\n    \"RMSE\": baseline_cv_rmse_scores\n})\n\nprint(\"\\n===== CV FOLD SUMMARY =====\")\nprint(\n    cv_fold_summary.to_string(index=False)\n)\n\nprint(\n    f\"\\nAverage RMSE: \"\n    f\"₹{baseline_cv_mean_rmse:,.2f}\"\n)\n\nprint(\n    f\"Standard Deviation: \"\n    f\"₹{baseline_cv_std_rmse:,.2f}\"\n)\n\n\n# ============================================================\n# 12.7 — DEFINE RANDOM FOREST HYPERPARAMETER GRID\n# ============================================================\n\n# OBJECTIVE:\n# Define multiple hyperparameter combinations that GridSearchCV\n# will evaluate using cross-validation.\n#\n# Parameters:\n#\n# n_estimators:\n#     Number of trees.\n#\n# max_depth:\n#     Maximum depth of each tree.\n#\n# min_samples_split:\n#     Minimum samples required to split an internal node.\n#\n# min_samples_leaf:\n#     Minimum samples required in a leaf.\n#\n# max_features:\n#     Number/fraction of features considered when searching\n#     for a split.\n#\n# IMPORTANT:\n# The grid is deliberately kept moderate because this is a\n# learning project and Kaggle CPU resources should be used\n# efficiently.\n\nparam_grid = {\n    \"n_estimators\": [\n        100,\n        200,\n        300\n    ],\n\n    \"max_depth\": [\n        5,\n        8,\n        12,\n        None\n    ],\n\n    \"min_samples_split\": [\n        2,\n        5\n    ],\n\n    \"min_samples_leaf\": [\n        1,\n        2,\n        4\n    ],\n\n    \"max_features\": [\n        1.0,\n        \"sqrt\"\n    ]\n}\n\ntotal_combinations = (\n    len(param_grid[\"n_estimators\"])\n    * len(param_grid[\"max_depth\"])\n    * len(param_grid[\"min_samples_split\"])\n    * len(param_grid[\"min_samples_leaf\"])\n    * len(param_grid[\"max_features\"])\n)\n\ntotal_cv_fits = (\n    total_combinations\n    * kfold.n_splits\n)\n\nprint(\"\\n===== GRID SEARCH CONFIGURATION =====\")\n\nprint(\n    \"Number of hyperparameter combinations:\",\n    total_combinations\n)\n\nprint(\n    \"Number of CV folds:\",\n    kfold.n_splits\n)\n\nprint(\n    \"Total model fits:\",\n    total_cv_fits\n)\n\nprint(\"\\nParameter grid:\")\nfor parameter, values in param_grid.items():\n    print(\n        f\"{parameter}: {values}\"\n    )\n\n\n# ============================================================\n# 12.8 — RUN GRIDSEARCHCV\n# ============================================================\n\n# OBJECTIVE:\n# Search through all hyperparameter combinations using\n# 5-Fold Cross-Validation.\n#\n# refit=True:\n#     After finding the best hyperparameters, sklearn\n#     automatically retrains the best model on the complete\n#     training dataset.\n#\n# scoring:\n#     We optimize RMSE.\n#\n# Since sklearn maximizes scoring values, we use:\n#\n#     neg_root_mean_squared_error\n#\n# The best negative RMSE corresponds to the smallest\n# actual RMSE.\n\nrf_for_grid_search = RandomForestRegressor(\n    random_state=42,\n    n_jobs=-1\n)\n\ngrid_search = GridSearchCV(\n    estimator=rf_for_grid_search,\n    param_grid=param_grid,\n    scoring=\"neg_root_mean_squared_error\",\n    cv=kfold,\n    n_jobs=-1,\n    refit=True,\n    return_train_score=True\n)\n\nprint(\"\\n===== STARTING GRID SEARCH =====\")\nprint(\n    \"This may take some time depending on Kaggle CPU resources...\"\n)\n\ngrid_search.fit(\n    cv_X_train,\n    cv_y_train\n)\n\nprint(\"\\n===== GRID SEARCH COMPLETE =====\")\n\n\n# ============================================================\n# 12.9 — BEST CROSS-VALIDATION CONFIGURATION\n# ============================================================\n\n# OBJECTIVE:\n# Extract the hyperparameters that produced the best average\n# cross-validation RMSE.\n\nbest_rf_params = grid_search.best_params_\n\nbest_cv_negative_rmse = (\n    grid_search.best_score_\n)\n\nbest_cv_rmse = (\n    -best_cv_negative_rmse\n)\n\nprint(\"\\n===== BEST RANDOM FOREST CONFIGURATION =====\")\n\nfor parameter, value in best_rf_params.items():\n    print(\n        f\"{parameter}: {value}\"\n    )\n\nprint(\n    f\"\\nBest Mean CV RMSE: \"\n    f\"₹{best_cv_rmse:,.2f}\"\n)\n\n\n# ============================================================\n# 12.10 — INSPECT ALL GRID SEARCH RESULTS\n# ============================================================\n\n# OBJECTIVE:\n# Convert GridSearchCV results into a DataFrame so we can\n# inspect how different hyperparameter combinations performed.\n#\n# rank_test_score:\n#     Rank 1 means the best CV score.\n\ngrid_results = pd.DataFrame(\n    grid_search.cv_results_\n)\n\ngrid_results[\"Mean CV RMSE\"] = (\n    -grid_results[\"mean_test_score\"]\n)\n\ngrid_results[\"Std CV RMSE\"] = (\n    grid_results[\"std_test_score\"]\n)\n\ngrid_results_clean = grid_results[\n    [\n        \"rank_test_score\",\n        \"Mean CV RMSE\",\n        \"Std CV RMSE\",\n        \"param_n_estimators\",\n        \"param_max_depth\",\n        \"param_min_samples_split\",\n        \"param_min_samples_leaf\",\n        \"param_max_features\"\n    ]\n].copy()\n\ngrid_results_clean = (\n    grid_results_clean\n    .sort_values(\n        by=\"rank_test_score\"\n    )\n)\n\nprint(\"\\n===== TOP 15 GRID SEARCH RESULTS =====\")\n\nprint(\n    grid_results_clean\n    .head(15)\n    .to_string(index=False)\n)\n\n\n# ============================================================\n# 12.11 — TRAINING PERFORMANCE OF BEST CV MODEL\n# ============================================================\n\n# OBJECTIVE:\n# Evaluate the best CV-selected Random Forest on the complete\n# training dataset.\n#\n# This is NOT the final evaluation.\n#\n# The important final evaluation comes from the untouched test\n# set in the next section.\n\nbest_cv_model = grid_search.best_estimator_\n\nbest_cv_train_predictions = (\n    best_cv_model.predict(\n        cv_X_train\n    )\n)\n\nbest_cv_train_mae = mean_absolute_error(\n    cv_y_train,\n    best_cv_train_predictions\n)\n\nbest_cv_train_mse = mean_squared_error(\n    cv_y_train,\n    best_cv_train_predictions\n)\n\nbest_cv_train_rmse = np.sqrt(\n    best_cv_train_mse\n)\n\nbest_cv_train_r2 = r2_score(\n    cv_y_train,\n    best_cv_train_predictions\n)\n\nprint(\"\\n===== BEST CV MODEL — TRAINING PERFORMANCE =====\")\n\nprint(\n    f\"MAE:  ₹{best_cv_train_mae:,.2f}\"\n)\n\nprint(\n    f\"MSE:  {best_cv_train_mse:,.2f}\"\n)\n\nprint(\n    f\"RMSE: ₹{best_cv_train_rmse:,.2f}\"\n)\n\nprint(\n    f\"R²:   {best_cv_train_r2:.6f}\"\n)\n\n\n# ============================================================\n# 12.12 — FINAL TEST EVALUATION\n# ============================================================\n\n# OBJECTIVE:\n# Perform the FINAL evaluation on the untouched test set.\n#\n# This is the first point in this step where the test data\n# influences our reported performance.\n#\n# We do NOT tune anything based on this result.\n\nfinal_test_predictions = (\n    best_cv_model.predict(\n        final_X_test\n    )\n)\n\nfinal_test_mae = mean_absolute_error(\n    final_y_test,\n    final_test_predictions\n)\n\nfinal_test_mse = mean_squared_error(\n    final_y_test,\n    final_test_predictions\n)\n\nfinal_test_rmse = np.sqrt(\n    final_test_mse\n)\n\nfinal_test_r2 = r2_score(\n    final_y_test,\n    final_test_predictions\n)\n\nprint(\"\\n===== FINAL TEST PERFORMANCE =====\")\n\nprint(\n    f\"MAE:  ₹{final_test_mae:,.2f}\"\n)\n\nprint(\n    f\"MSE:  {final_test_mse:,.2f}\"\n)\n\nprint(\n    f\"RMSE: ₹{final_test_rmse:,.2f}\"\n)\n\nprint(\n    f\"R²:   {final_test_r2:.6f}\"\n)\n\n\n# ============================================================\n# 12.13 — CV VS FINAL TEST\n# ============================================================\n\n# OBJECTIVE:\n# Compare the cross-validation estimate with the final test\n# performance.\n#\n# These numbers do not have to be identical.\n#\n# CV estimates performance by repeatedly validating on subsets\n# of the training data.\n#\n# The final test evaluates the model on completely held-out\n# observations.\n\ncv_vs_test = pd.DataFrame({\n    \"Evaluation\": [\n        \"5-Fold CV Mean\",\n        \"Final Test\"\n    ],\n\n    \"RMSE\": [\n        best_cv_rmse,\n        final_test_rmse\n    ],\n\n    \"R²\": [\n        np.nan,\n        final_test_r2\n    ]\n})\n\nprint(\"\\n===== CROSS-VALIDATION VS FINAL TEST =====\")\nprint(\n    cv_vs_test.to_string(index=False)\n)\n\n\n# ============================================================\n# 12.14 — COMPARE ALL MAJOR MODELS\n# ============================================================\n\n# OBJECTIVE:\n# Compare:\n#\n# 1. Linear Regression\n# 2. Decision Tree\n# 3. Step 11 Random Forest\n# 4. Properly tuned Random Forest using CV\n#\n# All final model metrics are measured on the same test set.\n\nmodel_comparison_step12 = pd.DataFrame([\n    {\n        \"Model\": \"Linear Regression\",\n        \"MAE\": linear_mae,\n        \"RMSE\": linear_rmse,\n        \"R²\": linear_r2\n    },\n\n    {\n        \"Model\": \"Decision Tree\",\n        \"MAE\": selected_tree_mae,\n        \"RMSE\": selected_tree_rmse,\n        \"R²\": selected_tree_r2\n    },\n\n    {\n        \"Model\": \"Random Forest — Step 11\",\n        \"MAE\": selected_forest_mae,\n        \"RMSE\": selected_forest_rmse,\n        \"R²\": selected_forest_r2\n    },\n\n    {\n        \"Model\": \"Random Forest — CV Tuned\",\n        \"MAE\": final_test_mae,\n        \"RMSE\": final_test_rmse,\n        \"R²\": final_test_r2\n    }\n])\n\nprint(\"\\n===== COMPLETE MODEL COMPARISON =====\")\n\nprint(\n    model_comparison_step12\n    .to_string(index=False)\n)\n\n\n# ============================================================\n# 12.15 — FINAL MODEL FEATURE IMPORTANCE\n# ============================================================\n\n# OBJECTIVE:\n# Examine which features the properly tuned Random Forest uses\n# most heavily for its predictions.\n\nfinal_forest_feature_importance = pd.DataFrame({\n    \"Feature\": feature_names,\n    \"Importance\": best_cv_model.feature_importances_\n})\n\nfinal_forest_feature_importance = (\n    final_forest_feature_importance\n    .sort_values(\n        by=\"Importance\",\n        ascending=False\n    )\n)\n\nprint(\"\\n===== FINAL RANDOM FOREST FEATURE IMPORTANCE =====\")\n\nprint(\n    final_forest_feature_importance\n    .to_string(index=False)\n)\n\n\n# ============================================================\n# 12.16 — PLOT FINAL FEATURE IMPORTANCE\n# ============================================================\n\n# OBJECTIVE:\n# Visualize the top 15 features used by the properly tuned\n# Random Forest.\n\ntop_features = (\n    final_forest_feature_importance\n    .head(15)\n    .sort_values(\n        by=\"Importance\"\n    )\n)\n\nplt.figure(figsize=(10, 7))\n\nplt.barh(\n    top_features[\"Feature\"],\n    top_features[\"Importance\"]\n)\n\nplt.xlabel(\"Feature Importance\")\nplt.ylabel(\"Feature\")\nplt.title(\n    \"Properly Tuned Random Forest — Feature Importance\"\n)\n\nplt.grid(True)\n\nplt.show()\n\n\n# ============================================================\n# 12.17 — ACTUAL VS PREDICTED PRICE\n# ============================================================\n\n# OBJECTIVE:\n# Visualize predictions from the properly tuned Random Forest.\n#\n# Points close to the diagonal indicate predictions close to\n# the actual prices.\n\nplt.figure(figsize=(8, 6))\n\nplt.scatter(\n    final_y_test,\n    final_test_predictions,\n    alpha=0.7\n)\n\nminimum_price = min(\n    final_y_test.min(),\n    final_test_predictions.min()\n)\n\nmaximum_price = max(\n    final_y_test.max(),\n    final_test_predictions.max()\n)\n\nplt.plot(\n    [minimum_price, maximum_price],\n    [minimum_price, maximum_price],\n    linestyle=\"--\"\n)\n\nplt.xlabel(\"Actual Price\")\nplt.ylabel(\"Predicted Price\")\n\nplt.title(\n    \"Properly Tuned Random Forest — Actual vs Predicted\"\n)\n\nplt.grid(True)\n\nplt.show()\n\n\n# ============================================================\n# 12.18 — FINAL PREDICTION EXAMPLES\n# ============================================================\n\n# OBJECTIVE:\n# Inspect individual predictions and their errors.\n\nfinal_prediction_table = pd.DataFrame({\n    \"Actual Price\": final_y_test.values,\n    \"Predicted Price\": final_test_predictions\n})\n\nfinal_prediction_table[\"Error\"] = (\n    final_prediction_table[\"Actual Price\"]\n    - final_prediction_table[\"Predicted Price\"]\n)\n\nfinal_prediction_table[\"Absolute Error\"] = (\n    np.abs(\n        final_prediction_table[\"Error\"]\n    )\n)\n\nprint(\"\\n===== FINAL RANDOM FOREST PREDICTIONS =====\")\n\nprint(\n    final_prediction_table\n    .head(10)\n    .to_string(index=False)\n)\n\n\n# ============================================================\n# 12.19 — FINAL SUMMARY\n# ============================================================\n\n# OBJECTIVE:\n# Print the most important results from the complete\n# cross-validation and hyperparameter tuning experiment.\n\nprint(\"\\n\")\nprint(\"=\" * 80)\nprint(\"STEP 12 — CROSS-VALIDATION + HYPERPARAMETER TUNING SUMMARY\")\nprint(\"=\" * 80)\