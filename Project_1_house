# 11.4  Understand Random Forest parameters\n# 11.5  Train a basic Random Forest\n# 11.6  Generate predictions\n# 11.7  Evaluate training performance\n# 11.8  Evaluate testing performance\n# 11.9  Compare training vs testing\n# 11.10 Experiment with number of trees\n# 11.11 Experiment with tree depth\n# 11.12 Experiment with minimum leaf size\n# 11.13 Compare Random Forest configurations\n# 11.14 Select the best tested configuration\n# 11.15 Train the selected Random Forest\n# 11.16 Compare Linear Regression vs Decision Tree vs Random Forest\n# 11.17 Analyze Random Forest feature importance\n# 11.18 Plot feature importance\n# 11.19 Plot actual vs predicted prices\n# 11.20 Final summary\n#\n# IMPORTANT:\n#\n# A Random Forest creates many Decision Trees.\n#\n# Each tree learns a slightly different representation of the data.\n# The Random Forest combines their predictions, which can reduce\n# the instability of an individual Decision Tree.\n#\n# For regression, the final prediction is approximately:\n#\n#     Random Forest Prediction\n#     = average of predictions from all trees\n#\n# Main parameters:\n#\n# n_estimators:\n#     Number of trees in the forest.\n#\n# max_depth:\n#     Maximum depth of each tree.\n#\n# min_samples_split:\n#     Minimum number of samples required to split a node.\n#\n# min_samples_leaf:\n#     Minimum number of samples allowed in a leaf.\n#\n# random_state:\n#     Makes the experiment reproducible.\n\n\n# ============================================================\n# 11.1 — IMPORT REQUIRED LIBRARIES\n# ============================================================\n\n# OBJECTIVE:\n# Import RandomForestRegressor, evaluation metrics and plotting\n# libraries required for this experiment.\n\nimport numpy as np\nimport pandas as pd\nimport matplotlib.pyplot as plt\n\nfrom sklearn.ensemble import RandomForestRegressor\n\nfrom sklearn.metrics import (\n    mean_absolute_error,\n    mean_squared_error,\n    r2_score\n)\n\n\n# ============================================================\n# 11.2 — VERIFY REQUIRED VARIABLES\n# ============================================================\n\n# OBJECTIVE:\n# Make sure the feature matrices, target variables and Linear\n# Regression results from previous steps are available.\n\nrequired_variables = [\n    \"X_train_processed\",\n    \"X_test_processed\",\n    \"y_train\",\n    \"y_test\",\n    \"feature_names\",\n    \"linear_mae\",\n    \"linear_rmse\",\n    \"linear_r2\",\n    \"selected_tree_mae\",\n    \"selected_tree_rmse\",\n    \"selected_tree_r2\"\n]\n\nmissing_variables = [\n    variable\n    for variable in required_variables\n    if variable not in globals()\n]\n\nif missing_variables:\n    raise NameError(\n        \"The following variables are missing: \"\n        + \", \".join(missing_variables)\n        + \". Please run the previous project steps first.\"\n    )\n\nprint(\"===== REQUIRED VARIABLES CHECK =====\")\nprint(\"All required variables are available.\")\n\n\n# ============================================================\n# 11.3 — PREPARE RANDOM FOREST DATA\n# ============================================================\n\n# OBJECTIVE:\n# Use the one-hot encoded feature representation created earlier.\n#\n# Random Forest does not require StandardScaler because Decision\n# Trees are based on threshold comparisons.\n#\n# Therefore, we use the same encoded representation that we used\n# for our Decision Tree.\n\nforest_X_train = X_train_processed\nforest_X_test = X_test_processed\n\nforest_y_train = y_train\nforest_y_test = y_test\n\nprint(\"\\n===== RANDOM FOREST DATA =====\")\nprint(\"Training samples:\", forest_X_train.shape[0])\nprint(\"Testing samples:\", forest_X_test.shape[0])\nprint(\"Number of features:\", forest_X_train.shape[1])\n\n\n# ============================================================\n# 11.4 — TRAIN BASIC RANDOM FOREST\n# ============================================================\n\n# OBJECTIVE:\n# Train an initial Random Forest with a moderate number of trees.\n#\n# n_estimators=100 means the forest contains 100 Decision Trees.\n#\n# max_depth=6 is chosen initially because our single Decision Tree\n# experiment showed that depth 6 gave the best test RMSE among\n# the depths we tested.\n#\n# n_jobs=-1 tells sklearn to use all available CPU cores for\n# training, which can make the experiment faster.\n#\n# random_state=42 makes the result reproducible.\n\nbasic_forest = RandomForestRegressor(\n    n_estimators=100,\n    max_depth=6,\n    random_state=42,\n    n_jobs=-1\n)\n\n# Train all trees in the Random Forest.\nbasic_forest.fit(\n    forest_X_train,\n    forest_y_train\n)\n\nprint(\"\\n===== BASIC RANDOM FOREST TRAINED =====\")\nprint(\"Number of trees:\", basic_forest.n_estimators)\nprint(\"Maximum tree depth:\", basic_forest.max_depth)\nprint(\"Number of features:\", basic_forest.n_features_in_)\n\n\n# ============================================================\n# 11.5 — GENERATE TEST PREDICTIONS\n# ============================================================\n\n# OBJECTIVE:\n# Generate house-price predictions for the unseen test set.\n\nbasic_forest_test_predictions = basic_forest.predict(\n    forest_X_test\n)\n\nprint(\"\\n===== RANDOM FOREST TEST PREDICTIONS =====\")\nprint(\n    \"Number of predictions:\",\n    len(basic_forest_test_predictions)\n)\n\nbasic_forest_prediction_comparison = pd.DataFrame({\n    \"Actual Price\": forest_y_test.values,\n    \"Predicted Price\": basic_forest_test_predictions\n})\n\nbasic_forest_prediction_comparison[\"Error\"] = (\n    basic_forest_prediction_comparison[\"Actual Price\"]\n    - basic_forest_prediction_comparison[\"Predicted Price\"]\n)\n\nbasic_forest_prediction_comparison[\"Absolute Error\"] = (\n    np.abs(\n        basic_forest_prediction_comparison[\"Error\"]\n    )\n)\n\nprint(\n    basic_forest_prediction_comparison\n    .head(10)\n    .to_string(index=False)\n)\n\n\n# ============================================================\n# 11.6 — EVALUATE RANDOM FOREST ON TRAINING DATA\n# ============================================================\n\n# OBJECTIVE:\n# Measure how well the Random Forest predicts the training data.\n#\n# Comparing training and test performance helps us identify\n# whether the forest is overfitting.\n\nbasic_forest_train_predictions = basic_forest.predict(\n    forest_X_train\n)\n\nbasic_forest_train_mae = mean_absolute_error(\n    forest_y_train,\n    basic_forest_train_predictions\n)\n\nbasic_forest_train_mse = mean_squared_error(\n    forest_y_train,\n    basic_forest_train_predictions\n)\n\nbasic_forest_train_rmse = np.sqrt(\n    basic_forest_train_mse\n)\n\nbasic_forest_train_r2 = r2_score(\n    forest_y_train,\n    basic_forest_train_predictions\n)\n\nprint(\"\\n===== RANDOM FOREST — TRAINING PERFORMANCE =====\")\nprint(f\"MAE:  ₹{basic_forest_train_mae:,.2f}\")\nprint(f\"MSE:  {basic_forest_train_mse:,.2f}\")\nprint(f\"RMSE: ₹{basic_forest_train_rmse:,.2f}\")\nprint(f\"R²:   {basic_forest_train_r2:.6f}\")\n\n\n# ============================================================\n# 11.7 — EVALUATE RANDOM FOREST ON TEST DATA\n# ============================================================\n\n# OBJECTIVE:\n# Evaluate the Random Forest on the unseen test set.\n\nbasic_forest_test_mae = mean_absolute_error(\n    forest_y_test,\n    basic_forest_test_predictions\n)\n\nbasic_forest_test_mse = mean_squared_error(\n    forest_y_test,\n    basic_forest_test_predictions\n)\n\nbasic_forest_test_rmse = np.sqrt(\n    basic_forest_test_mse\n)\n\nbasic_forest_test_r2 = r2_score(\n    forest_y_test,\n    basic_forest_test_predictions\n)\n\nprint(\"\\n===== RANDOM FOREST — TEST PERFORMANCE =====\")\nprint(f\"MAE:  ₹{basic_forest_test_mae:,.2f}\")\nprint(f\"MSE:  {basic_forest_test_mse:,.2f}\")\nprint(f\"RMSE: ₹{basic_forest_test_rmse:,.2f}\")\nprint(f\"R²:   {basic_forest_test_r2:.6f}\")\n\n\n# ============================================================\n# 11.8 — COMPARE TRAINING VS TESTING\n# ============================================================\n\n# OBJECTIVE:\n# Compare training and testing performance side by side.\n#\n# A large difference between training and testing performance\n# indicates that the model may be overfitting.\n\nbasic_forest_comparison = pd.DataFrame({\n    \"Dataset\": [\n        \"Training\",\n        \"Testing\"\n    ],\n\n    \"MAE\": [\n        basic_forest_train_mae,\n        basic_forest_test_mae\n    ],\n\n    \"RMSE\": [\n        basic_forest_train_rmse,\n        basic_forest_test_rmse\n    ],\n\n    \"R²\": [\n        basic_forest_train_r2,\n        basic_forest_test_r2\n    ]\n})\n\nprint(\"\\n===== RANDOM FOREST — TRAIN VS TEST =====\")\nprint(\n    basic_forest_comparison\n    .to_string(index=False)\n)\n\n\n# ============================================================\n# 11.9 — EXPERIMENT WITH NUMBER OF TREES\n# ============================================================\n\n# OBJECTIVE:\n# Investigate how the number of Decision Trees affects Random\n# Forest performance.\n#\n# More trees generally make the ensemble more stable, although\n# the improvement eventually becomes smaller.\n#\n# We test:\n#\n#     10\n#     25\n#     50\n#     100\n#     200\n#     300\n#\n# All other parameters remain fixed so that we isolate the effect\n# of n_estimators.\n\nn_estimators_values = [\n    10,\n    25,\n    50,\n    100,\n    200,\n    300\n]\n\nforest_tree_count_results = []\n\nfor n_estimators in n_estimators_values:\n\n    # Create a Random Forest with the current number of trees.\n    forest = RandomForestRegressor(\n        n_estimators=n_estimators,\n        max_depth=6,\n        random_state=42,\n        n_jobs=-1\n    )\n\n    # Train the forest.\n    forest.fit(\n        forest_X_train,\n        forest_y_train\n    )\n\n    # Generate test predictions.\n    predictions = forest.predict(\n        forest_X_test\n    )\n\n    # Calculate metrics.\n    mae = mean_absolute_error(\n        forest_y_test,\n        predictions\n    )\n\n    mse = mean_squared_error(\n        forest_y_test,\n        predictions\n    )\n\n    rmse = np.sqrt(mse)\n\n    r2 = r2_score(\n        forest_y_test,\n        predictions\n    )\n\n    forest_tree_count_results.append({\n        \"Number of Trees\": n_estimators,\n        \"MAE\": mae,\n        \"MSE\": mse,\n        \"RMSE\": rmse,\n        \"R²\": r2\n    })\n\n\nforest_tree_count_results_df = pd.DataFrame(\n    forest_tree_count_results\n)\n\nprint(\"\\n===== NUMBER OF TREES EXPERIMENT =====\")\nprint(\n    forest_tree_count_results_df\n    .to_string(index=False)\n)\n\n\n# ============================================================\n# 11.10 — PLOT NUMBER OF TREES VS RMSE\n# ============================================================\n\n# OBJECTIVE:\n# Visualize whether adding more trees improves Random Forest\n# prediction error.\n\nplt.figure(figsize=(9, 6))\n\nplt.plot(\n    forest_tree_count_results_df[\"Number of Trees\"],\n    forest_tree_count_results_df[\"RMSE\"],\n    marker=\"o\"\n)\n\nplt.xlabel(\"Number of Trees\")\nplt.ylabel(\"Test RMSE\")\nplt.title(\"Random Forest — Number of Trees vs RMSE\")\n\nplt.grid(True)\n\nplt.show()\n\n\n# ============================================================\n# 11.11 — EXPERIMENT WITH MAX_DEPTH\n# ============================================================\n\n# OBJECTIVE:\n# Investigate how the maximum depth of the individual trees\n# affects Random Forest performance.\n#\n# Shallow trees may underfit.\n#\n# Very deep trees can become complex and may overfit.\n#\n# We keep n_estimators fixed at 200 for this experiment.\n\nforest_depth_values = [\n    2,\n    3,\n    4,\n    5,\n    6,\n    7,\n    8,\n    10,\n    12,\n    None\n]\n\nforest_depth_results = []\n\nfor depth in forest_depth_values:\n\n    forest = RandomForestRegressor(\n        n_estimators=200,\n        max_depth=depth,\n        random_state=42,\n        n_jobs=-1\n    )\n\n    forest.fit(\n        forest_X_train,\n        forest_y_train\n    )\n\n    # Training predictions.\n    train_predictions = forest.predict(\n        forest_X_train\n    )\n\n    # Test predictions.\n    test_predictions = forest.predict(\n        forest_X_test\n    )\n\n    # Training metrics.\n    train_rmse = np.sqrt(\n        mean_squared_error(\n            forest_y_train,\n            train_predictions\n        )\n    )\n\n    train_r2 = r2_score(\n        forest_y_train,\n        train_predictions\n    )\n\n    # Test metrics.\n    test_rmse = np.sqrt(\n        mean_squared_error(\n            forest_y_test,\n            test_predictions\n        )\n    )\n\n    test_r2 = r2_score(\n        forest_y_test,\n        test_predictions\n    )\n\n    forest_depth_results.append({\n        \"Max Depth\": depth,\n        \"Train RMSE\": train_rmse,\n        \"Test RMSE\": test_rmse,\n        \"Train R²\": train_r2,\n        \"Test R²\": test_r2\n    })\n\n\nforest_depth_results_df = pd.DataFrame(\n    forest_depth_results\n)\n\nprint(\"\\n===== RANDOM FOREST DEPTH EXPERIMENT =====\")\nprint(\n    forest_depth_results_df\n    .to_string(index=False)\n)\n\n\n# ============================================================\n# 11.12 — PLOT FOREST DEPTH VS RMSE\n# ============================================================\n\n# OBJECTIVE:\n# Visualize how Random Forest test and training error change as\n# the depth of individual trees changes.\n#\n# The None configuration is excluded from the graph because\n# it represents unlimited depth rather than a numerical depth.\n\nforest_plot_depth_df = forest_depth_results_df[\n    forest_depth_results_df[\"Max Depth\"].notna()\n].copy()\n\nplt.figure(figsize=(10, 6))\n\nplt.plot(\n    forest_plot_depth_df[\"Max Depth\"],\n    forest_plot_depth_df[\"Train RMSE\"],\n    marker=\"o\",\n    label=\"Training RMSE\"\n)\n\nplt.plot(\n    forest_plot_depth_df[\"Max Depth\"],\n    forest_plot_depth_df[\"Test RMSE\"],\n    marker=\"o\",\n    label=\"Testing RMSE\"\n)\n\nplt.xlabel(\"Maximum Tree Depth\")\nplt.ylabel(\"RMSE\")\nplt.title(\"Random Forest — Tree Depth vs RMSE\")\n\nplt.legend()\nplt.grid(True)\n\nplt.show()\n\n\n# ============================================================\n# 11.13 — EXPERIMENT WITH MINIMUM LEAF SIZE\n# ============================================================\n\n# OBJECTIVE:\n# Investigate min_samples_leaf.\n#\n# min_samples_leaf controls the minimum number of training\n# observations that must exist in a leaf.\n#\n# Larger values prevent individual trees from creating extremely\n# small leaves and can therefore reduce overfitting.\n#\n# We keep:\n#\n#     n_estimators = 200\n#     max_depth = 6\n#\n# and change only min_samples_leaf.\n\nleaf_values = [\n    1,\n    2,\n    4,\n    6,\n    10,\n    15,\n    20\n]\n\nforest_leaf_results = []\n\nfor leaf_size in leaf_values:\n\n    forest = RandomForestRegressor(\n        n_estimators=200,\n        max_depth=6,\n        min_samples_leaf=leaf_size,\n        random_state=42,\n        n_jobs=-1\n    )\n\n    forest.fit(\n        forest_X_train,\n        forest_y_train\n    )\n\n    # Generate test predictions.\n    predictions = forest.predict(\n        forest_X_test\n    )\n\n    # Calculate metrics.\n    mae = mean_absolute_error(\n        forest_y_test,\n        predictions\n    )\n\n    mse = mean_squared_error(\n        forest_y_test,\n        predictions\n    )\n\n    rmse = np.sqrt(mse)\n\n    r2 = r2_score(\n        forest_y_test,\n        predictions\n    )\n\n    forest_leaf_results.append({\n        \"Min Samples Leaf\": leaf_size,\n        \"MAE\": mae,\n        \"MSE\": mse,\n        \"RMSE\": rmse,\n        \"R²\": r2\n    })\n\n\nforest_leaf_results_df = pd.DataFrame(\n    forest_leaf_results\n)\n\nprint(\"\\n===== MINIMUM LEAF SIZE EXPERIMENT =====\")\nprint(\n    forest_leaf_results_df\n    .to_string(index=False)\n)\n\n\n# ============================================================\n# 11.14 — PLOT MINIMUM LEAF SIZE VS RMSE\n# ============================================================\n\n# OBJECTIVE:\n# Visualize how increasing the minimum leaf size affects test\n# prediction error.\n\nplt.figure(figsize=(9, 6))\n\nplt.plot(\n    forest_leaf_results_df[\"Min Samples Leaf\"],\n    forest_leaf_results_df[\"RMSE\"],\n    marker=\"o\"\n)\n\nplt.xlabel(\"Minimum Samples per Leaf\")\nplt.ylabel(\"Test RMSE\")\nplt.title(\n    \"Random Forest — Minimum Leaf Size vs RMSE\"\n)\n\nplt.grid(True)\n\nplt.show()\n\n\n# ============================================================\n# 11.15 — FIND BEST TESTED CONFIGURATION\n# ============================================================\n\n# OBJECTIVE:\n# Find the best configuration from our three experiments.\n#\n# We use test RMSE for this learning experiment.\n#\n# IMPORTANT:\n# In a rigorous production workflow, hyperparameters should be\n# selected using cross-validation on the training data and the\n# test set should be reserved for final evaluation.\n\nbest_tree_count_index = (\n    forest_tree_count_results_df[\"RMSE\"]\n    .idxmin()\n)\n\nbest_tree_count_row = (\n    forest_tree_count_results_df\n    .loc[best_tree_count_index]\n)\n\nbest_depth_index = (\n    forest_depth_results_df[\"Test RMSE\"]\n    .idxmin()\n)\n\nbest_depth_row_forest = (\n    forest_depth_results_df\n    .loc[best_depth_index]\n)\n\nbest_leaf_index = (\n    forest_leaf_results_df[\"RMSE\"]\n    .idxmin()\n)\n\nbest_leaf_row = (\n    forest_leaf_results_df\n    .loc[best_leaf_index]\n)\n\nprint(\"\\n===== BEST CONFIGURATION FROM EACH EXPERIMENT =====\")\n\nprint(\"\\nBest Number of Trees:\")\nprint(\n    best_tree_count_row.to_string()\n)\n\nprint(\"\\nBest Max Depth:\")\nprint(\n    best_depth_row_forest.to_string()\n)\n\nprint(\"\\nBest Min Samples Leaf:\")\nprint(\n    best_leaf_row.to_string()\n)\n\n\n# ============================================================\n# 11.16 — TRAIN SELECTED RANDOM FOREST\n# ============================================================\n\n# OBJECTIVE:\n# Combine the useful hyperparameter choices discovered during\n# our experiments into one Random Forest configuration.\n#\n# For this experiment, we use:\n#\n#     n_estimators = best tree count\n#     max_depth = best tested depth\n#     min_samples_leaf = best tested leaf size\n#\n# If the depth experiment selects None, we preserve None.\n#\n# The explicit int conversion prevents the same np.float64 issue\n# we encountered with Decision Tree max_depth.\n\nselected_n_estimators = int(\n    best_tree_count_row[\"Number of Trees\"]\n)\n\nif pd.isna(best_depth_row_forest[\"Max Depth\"]):\n    selected_max_depth = None\nelse:\n    selected_max_depth = int(\n        best_depth_row_forest[\"Max Depth\"]\n    )\n\nselected_min_samples_leaf = int(\n    best_leaf_row[\"Min Samples Leaf\"]\n)\n\nselected_forest = RandomForestRegressor(\n    n_estimators=selected_n_estimators,\n    max_depth=selected_max_depth,\n    min_samples_leaf=selected_min_samples_leaf,\n    random_state=42,\n    n_jobs=-1\n)\n\nselected_forest.fit(\n    forest_X_train,\n    forest_y_train\n)\n\n# Generate final test predictions.\nselected_forest_predictions = (\n    selected_forest.predict(\n        forest_X_test\n    )\n)\n\n# Calculate final metrics.\nselected_forest_mae = mean_absolute_error(\n    forest_y_test,\n    selected_forest_predictions\n)\n\nselected_forest_mse = mean_squared_error(\n    forest_y_test,\n    selected_forest_predictions\n)\n\nselected_forest_rmse = np.sqrt(\n    selected_forest_mse\n)\n\nselected_forest_r2 = r2_score(\n    forest_y_test,\n    selected_forest_predictions\n)\n\nprint(\"\\n===== SELECTED RANDOM FOREST =====\")\nprint(\n    \"Number of trees:\",\n    selected_n_estimators\n)\nprint(\n    \"Maximum depth:\",\n    selected_max_depth\n)\nprint(\n    \"Minimum samples per leaf:\",\n    selected_min_samples_leaf\n)\n\nprint(f\"\\nMAE:  ₹{selected_forest_mae:,.2f}\")\nprint(f\"MSE:  {selected_forest_mse:,.2f}\")\nprint(f\"RMSE: ₹{selected_forest_rmse:,.2f}\")\nprint(f\"R²:   {selected_forest_r2:.6f}\")\n\n\n# ============================================================\n# 11.17 — TRAINING PERFORMANCE OF SELECTED FOREST\n# ============================================================\n\n# OBJECTIVE:\n# Compare selected Random Forest training performance with its\n# test performance to check for overfitting.\n\nselected_forest_train_predictions = (\n    selected_forest.predict(\n        forest_X_train\n    )\n)\n\nselected_forest_train_mae = mean_absolute_error(\n    forest_y_train,\n    selected_forest_train_predictions\n)\n\nselected_forest_train_mse = mean_squared_error(\n    forest_y_train,\n    selected_forest_train_predictions\n)\n\nselected_forest_train_rmse = np.sqrt(\n    selected_forest_train_mse\n)\n\nselected_forest_train_r2 = r2_score(\n    forest_y_train,\n    selected_forest_train_predictions\n)\n\nprint(\"\\n===== SELECTED RANDOM FOREST — TRAINING =====\")\nprint(\n    f\"MAE:  ₹{selected_forest_train_mae:,.2f}\"\n)\nprint(\n    f\"MSE:  {selected_forest_train_mse:,.2f}\"\n)\nprint(\n    f\"RMSE: ₹{selected_forest_train_rmse:,.2f}\"\n)\nprint(\n    f\"R²:   {selected_forest_train_r2:.6f}\"\n)\n\n\n# ============================================================\n# 11.18 — COMPARE LINEAR, TREE AND RANDOM FOREST\n# ============================================================\n\n# OBJECTIVE:\n# Compare the three major approaches we have now studied:\n#\n#     Linear Regression\n#     Decision Tree\n#     Random Forest\n#\n# All models are evaluated on the same test set.\n\nmodel_comparison_step11 = pd.DataFrame([\n    {\n        \"Model\": \"Linear Regression\",\n        \"MAE\": linear_mae,\n        \"RMSE\": linear_rmse,\n        \"R²\": linear_r2\n    },\n    {\n        \"Model\": \"Decision Tree\",\n        \"MAE\": selected_tree_mae,\n        \"RMSE\": selected_tree_rmse,\n        \"R²\": selected_tree_r2\n    },\n    {\n        \"Model\": \"Random Forest\",\n        \"MAE\": selected_forest_mae,\n        \"RMSE\": selected_forest_rmse,\n        \"R²\": selected_forest_r2\n    }\n])\n\nprint(\"\\n===== LINEAR vs DECISION TREE vs RANDOM FOREST =====\")\nprint(\n    model_comparison_step11\n    .to_string(index=False)\n)\n\n\n# ============================================================\n# 11.19 — RANDOM FOREST FEATURE IMPORTANCE\n# ============================================================\n\n# OBJECTIVE:\n# Determine which features contributed most to the Random Forest's\n# predictions.\n#\n# Random Forest feature importance is aggregated across all trees.\n#\n# IMPORTANT:\n# Feature importance indicates how useful a feature was for the\n# forest's splitting decisions. It does not prove causation.\n\nforest_feature_importance = pd.DataFrame({\n    \"Feature\": feature_names,\n    \"Importance\": selected_forest.feature_importances_\n})\n\nforest_feature_importance = (\n    forest_feature_importance\n    .sort_values(\n        by=\"Importance\",\n        ascending=False\n    )\n)\n\nprint(\"\\n===== RANDOM FOREST FEATURE IMPORTANCE =====\")\nprint(\n    forest_feature_importance\n    .to_string(index=False)\n)\n\n\n# ============================================================\n# 11.20 — PLOT RANDOM FOREST FEATURE IMPORTANCE\n# ============================================================\n\n# OBJECTIVE:\n# Visualize the most important features according to the\n# selected Random Forest.\n\nforest_importance_to_plot = (\n    forest_feature_importance\n    .head(15)\n    .sort_values(\n        by=\"Importance\"\n    )\n)\n\nplt.figure(figsize=(10, 7))\n\nplt.barh(\n    forest_importance_to_plot[\"Feature\"],\n    forest_importance_to_plot[\"Importance\"]\n)\n\nplt.xlabel(\"Feature Importance\")\nplt.ylabel(\"Feature\")\nplt.title(\n    \"Random Forest Feature Importance\"\n)\n\nplt.show()\n\n\n# ============================================================\n# 11.21 — ACTUAL VS PREDICTED PRICES\n# ============================================================\n\n# OBJEC