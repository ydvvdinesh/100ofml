48e+05\n      3353000     3.141169e+06  2.118306e+05    2.118306e+05\n\n\n================================================================================\nSTEP 12 — CROSS-VALIDATION + HYPERPARAMETER TUNING SUMMARY\n================================================================================\n\n----- CROSS-VALIDATION -----\nNumber of folds: 5\nBaseline CV RMSE: ₹1,086,020.76\nBest CV RMSE:     ₹1,035,238.36\n\n----- BEST HYPERPARAMETERS -----\nmax_depth: 8\nmax_features: sqrt\nmin_samples_leaf: 2\nmin_samples_split: 2\nn_estimators: 200\n\n----- FINAL TEST PERFORMANCE -----\nMAE:  ₹1,025,327.11\nMSE:  1,978,102,635,702.88\nRMSE: ₹1,406,450.37\nR²:   0.608651\n\n----- MODEL COMPARISON -----\n                   Model          MAE         RMSE       R²\n       Linear Regression 9.700434e+05 1.324507e+06 0.652924\n           Decision Tree 1.220774e+06 1.599875e+06 0.493607\n Random Forest — Step 11 1.048280e+06 1.375452e+06 0.625712\nRandom Forest — CV Tuned 1.025327e+06 1.406450e+06 0.608651\n\n================================================================================\nSTEP 12 COMPLETE\n================================================================================\n","output_type":"stream"}],"execution_count":63},{"cell_type":"code","source":"# ============================================================\n# STEP 13 — GRADIENT BOOSTING REGRESSION\n# COMPLETE STEP\n# ============================================================\n\n# OBJECTIVE:\n# Learn Gradient Boosting Regression from both the conceptual\n# and practical perspectives.\n#\n# We will:\n#\n# 13.1  Import required libraries\n# 13.2  Verify required variables\n# 13.3  Prepare the training/test data\n# 13.4  Understand the Gradient Boosting idea\n# 13.5  Train a basic Gradient Boosting model\n# 13.6  Generate predictions\n# 13.7  Evaluate training performance\n# 13.8  Evaluate test performance\n# 13.9  Compare training vs testing\n# 13.10 Experiment with number of boosting stages\n# 13.11 Experiment with learning rate\n# 13.12 Experiment with maximum tree depth\n# 13.13 Study learning-rate / estimator interaction\n# 13.14 Analyze feature importance\n# 13.15 Compare Linear Regression, Decision Tree,\n#       Random Forest and Gradient Boosting\n# 13.16 Inspect actual vs predicted prices\n# 13.17 Final summary\n#\n# IMPORTANT:\n#\n# Gradient Boosting is different from Random Forest.\n#\n# Random Forest:\n#     Many trees are trained largely independently.\n#     Their predictions are averaged.\n#\n# Gradient Boosting:\n#     Trees are added sequentially.\n#     Each new tree attempts to improve the current ensemble.\n#\n# Important parameters:\n#\n# n_estimators:\n#     Number of boosting stages / trees.\n#\n# learning_rate:\n#     How strongly each new tree contributes to the ensemble.\n#\n# max_depth:\n#     Maximum depth of the individual regression trees.\n#\n# min_samples_split:\n#     Minimum samples required to split an internal node.\n#\n# min_samples_leaf:\n#     Minimum samples required in a leaf.\n#\n# random_state:\n#     Makes the experiment reproducible.\n\n\n# ============================================================\n# 13.1 — IMPORT REQUIRED LIBRARIES\n# ============================================================\n\n# OBJECTIVE:\n# Import GradientBoostingRegressor, evaluation metrics and\n# plotting libraries.\n\nimport numpy as np\nimport pandas as pd\nimport matplotlib.pyplot as plt\n\nfrom sklearn.ensemble import GradientBoostingRegressor\n\nfrom sklearn.metrics import (\n    mean_absolute_error,\n    mean_squared_error,\n    r2_score\n)\n\n\n# ============================================================\n# 13.2 — VERIFY REQUIRED VARIABLES\n# ============================================================\n\n# OBJECTIVE:\n# Verify that the processed data and previous model results\n# are available before starting the Gradient Boosting experiment.\n\nrequired_variables = [\n    \"X_train_processed\",\n    \"X_test_processed\",\n    \"y_train\",\n    \"y_test\",\n    \"feature_names\",\n    \"linear_mae\",\n    \"linear_rmse\",\n    \"linear_r2\",\n    \"selected_tree_mae\",\n    \"selected_tree_rmse\",\n    \"selected_tree_r2\",\n    \"selected_forest_mae\",\n    \"selected_forest_rmse\",\n    \"selected_forest_r2\"\n]\n\nmissing_variables = [\n    variable\n    for variable in required_variables\n    if variable not in globals()\n]\n\nif missing_variables:\n    raise NameError(\n        \"Missing variables: \"\n        + \", \".join(missing_variables)\n        + \". Please run the previous project steps first.\"\n    )\n\nprint(\"===== REQUIRED VARIABLES CHECK =====\")\nprint(\"All required variables are available.\")\n\n\n# ============================================================\n# 13.3 — PREPARE DATA\n# ============================================================\n\n# OBJECTIVE:\n# Use the same one-hot encoded data representation used by the\n# previous Decision Tree and Random Forest experiments.\n#\n# Gradient Boosting is tree-based, so feature scaling is not\n# required.\n\ngb_X_train = X_train_processed\ngb_X_test = X_test_processed\n\ngb_y_train = y_train\ngb_y_test = y_test\n\nprint(\"\\n===== GRADIENT BOOSTING DATA =====\")\nprint(\"Training samples:\", gb_X_train.shape[0])\nprint(\"Testing samples:\", gb_X_test.shape[0])\nprint(\"Number of features:\", gb_X_train.shape[1])\n\n\n# ============================================================\n# 13.4 — UNDERSTAND THE GRADIENT BOOSTING IDEA\n# ============================================================\n\n# OBJECTIVE:\n# Understand the mathematical intuition behind Gradient Boosting\n# before training the model.\n#\n# Suppose our first model makes predictions:\n#\n#     y_hat_1\n#\n# The errors are:\n#\n#     residual = y - y_hat_1\n#\n# A new tree learns a function that attempts to predict these\n# residuals.\n#\n# The ensemble is then updated:\n#\n#     y_hat_2 =\n#         y_hat_1\n#         + learning_rate * tree_2_prediction\n#\n# This process continues:\n#\n#     y_hat_3 =\n#         y_hat_2\n#         + learning_rate * tree_3_prediction\n#\n# and eventually:\n#\n#     Final Prediction =\n#         Initial Prediction\n#         + contribution of Tree 1\n#         + contribution of Tree 2\n#         + ...\n#\n# The important idea is that the trees are NOT simply averaged\n# like Random Forest trees.\n#\n# They are added sequentially to improve the existing ensemble.\n\nprint(\"\\n===== GRADIENT BOOSTING CONCEPT =====\")\n\nprint(\"\"\"\nGradient Boosting builds trees sequentially.\n\nInitial model\n      ↓\nCalculate errors\n      ↓\nTrain next tree to improve those errors\n      ↓\nAdd a small contribution from that tree\n      ↓\nRepeat\n\nFinal model =\nInitial prediction\n+ Tree 1 contribution\n+ Tree 2 contribution\n+ Tree 3 contribution\n+ ...\n\"\"\")\n\n\n# ============================================================\n# 13.5 — TRAIN BASIC GRADIENT BOOSTING MODEL\n# ============================================================\n\n# OBJECTIVE:\n# Train a baseline Gradient Boosting Regressor.\n#\n# n_estimators=100:\n#     Build 100 boosting stages.\n#\n# learning_rate=0.1:\n#     Each tree contributes 10% of its learned correction.\n#\n# max_depth=3:\n#     Keep individual trees relatively shallow.\n#\n# Gradient Boosting commonly uses shallow trees because the\n# ensemble gains complexity by adding many trees sequentially.\n\nbasic_gb = GradientBoostingRegressor(\n    n_estimators=100,\n    learning_rate=0.1,\n    max_depth=3,\n    random_state=42\n)\n\nbasic_gb.fit(\n    gb_X_train,\n    gb_y_train\n)\n\nprint(\"\\n===== BASIC GRADIENT BOOSTING TRAINED =====\")\n\nprint(\n    \"Number of estimators:\",\n    basic_gb.n_estimators\n)\n\nprint(\n    \"Learning rate:\",\n    basic_gb.learning_rate\n)\n\nprint(\n    \"Maximum tree depth:\",\n    basic_gb.max_depth\n)\n\n\n# ============================================================\n# 13.6 — GENERATE PREDICTIONS\n# ============================================================\n\n# OBJECTIVE:\n# Generate predictions for both training and test data.\n\nbasic_gb_train_predictions = (\n    basic_gb.predict(\n        gb_X_train\n    )\n)\n\nbasic_gb_test_predictions = (\n    basic_gb.predict(\n        gb_X_test\n    )\n)\n\nprint(\"\\n===== PREDICTIONS GENERATED =====\")\n\nprint(\n    \"Training predictions:\",\n    len(basic_gb_train_predictions)\n)\n\nprint(\n    \"Testing predictions:\",\n    len(basic_gb_test_predictions)\n)\n\n\n# ============================================================\n# 13.7 — EVALUATE TRAINING PERFORMANCE\n# ============================================================\n\n# OBJECTIVE:\n# Measure how well Gradient Boosting fits the training data.\n\nbasic_gb_train_mae = mean_absolute_error(\n    gb_y_train,\n    basic_gb_train_predictions\n)\n\nbasic_gb_train_mse = mean_squared_error(\n    gb_y_train,\n    basic_gb_train_predictions\n)\n\nbasic_gb_train_rmse = np.sqrt(\n    basic_gb_train_mse\n)\n\nbasic_gb_train_r2 = r2_score(\n    gb_y_train,\n    basic_gb_train_predictions\n)\n\nprint(\"\\n===== GRADIENT BOOSTING — TRAINING =====\")\n\nprint(\n    f\"MAE:  ₹{basic_gb_train_mae:,.2f}\"\n)\n\nprint(\n    f\"MSE:  {basic_gb_train_mse:,.2f}\"\n)\n\nprint(\n    f\"RMSE: ₹{basic_gb_train_rmse:,.2f}\"\n)\n\nprint(\n    f\"R²:   {basic_gb_train_r2:.6f}\"\n)\n\n\n# ============================================================\n# 13.8 — EVALUATE TEST PERFORMANCE\n# ============================================================\n\n# OBJECTIVE:\n# Evaluate Gradient Boosting on the unseen test set.\n\nbasic_gb_test_mae = mean_absolute_error(\n    gb_y_test,\n    basic_gb_test_predictions\n)\n\nbasic_gb_test_mse = mean_squared_error(\n    gb_y_test,\n    basic_gb_test_predictions\n)\n\nbasic_gb_test_rmse = np.sqrt(\n    basic_gb_test_mse\n)\n\nbasic_gb_test_r2 = r2_score(\n    gb_y_test,\n    basic_gb_test_predictions\n)\n\nprint(\"\\n===== GRADIENT BOOSTING — TEST =====\")\n\nprint(\n    f\"MAE:  ₹{basic_gb_test_mae:,.2f}\"\n)\n\nprint(\n    f\"MSE:  {basic_gb_test_mse:,.2f}\"\n)\n\nprint(\n    f\"RMSE: ₹{basic_gb_test_rmse:,.2f}\"\n)\n\nprint(\n    f\"R²:   {basic_gb_test_r2:.6f}\"\n)\n\n\n# ============================================================\n# 13.9 — TRAIN VS TEST PERFORMANCE\n# ============================================================\n\n# OBJECTIVE:\n# Compare training and testing performance to identify possible\n# overfitting.\n\ngb_train_test_comparison = pd.DataFrame({\n    \"Dataset\": [\n        \"Training\",\n        \"Testing\"\n    ],\n\n    \"MAE\": [\n        basic_gb_train_mae,\n        basic_gb_test_mae\n    ],\n\n    \"RMSE\": [\n        basic_gb_train_rmse,\n        basic_gb_test_rmse\n    ],\n\n    \"R²\": [\n        basic_gb_train_r2,\n        basic_gb_test_r2\n    ]\n})\n\nprint(\"\\n===== GRADIENT BOOSTING — TRAIN VS TEST =====\")\n\nprint(\n    gb_train_test_comparison\n    .to_string(index=False)\n)\n\n\n# ============================================================\n# 13.10 — EXPERIMENT WITH NUMBER OF ESTIMATORS\n# ============================================================\n\n# OBJECTIVE:\n# Study how the number of sequential boosting stages affects\n# performance.\n#\n# Unlike Random Forest, increasing n_estimators means adding\n# more sequential correction stages.\n#\n# We test:\n#\n#     25\n#     50\n#     100\n#     200\n#     300\n#\n# Learning rate and tree depth remain fixed.\n\ngb_estimator_values = [\n    25,\n    50,\n    100,\n    200,\n    300\n]\n\ngb_estimator_results = []\n\nfor n_estimators in gb_estimator_values:\n\n    model = GradientBoostingRegressor(\n        n_estimators=n_estimators,\n        learning_rate=0.1,\n        max_depth=3,\n        random_state=42\n    )\n\n    model.fit(\n        gb_X_train,\n        gb_y_train\n    )\n\n    train_predictions = model.predict(\n        gb_X_train\n    )\n\n    test_predictions = model.predict(\n        gb_X_test\n    )\n\n    train_rmse = np.sqrt(