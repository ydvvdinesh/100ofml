n#\n# Therefore, whenever a model object is missing, we reconstruct\n# it using the configurations established during Project #1.\n#\n# IMPORTANT:\n# The test set is ONLY used for final evaluation in this step.\n\nimport numpy as np\nimport pandas as pd\nimport matplotlib.pyplot as plt\n\nfrom sklearn.linear_model import LinearRegression\nfrom sklearn.tree import DecisionTreeRegressor\nfrom sklearn.ensemble import (\n    RandomForestRegressor,\n    GradientBoostingRegressor\n)\n\nfrom sklearn.metrics import (\n    mean_absolute_error,\n    mean_squared_error,\n    r2_score\n)\n\nfrom xgboost import XGBRegressor\n\nprint(\"Step 15 imports completed.\")\n\n\n# ============================================================\n# 15.2 — VERIFY DATA\n# ============================================================\n# We need the processed training and test data created during\n# Step 4.\n#\n# These variables should contain the one-hot encoded dataset.\n\nrequired_data = [\n    \"X_train_processed\",\n    \"X_test_processed\",\n    \"y_train\",\n    \"y_test\"\n]\n\nprint(\"\\n15.2 — Checking required data\")\nprint(\"-\" * 70)\n\nfor variable_name in required_data:\n\n    if variable_name not in globals():\n\n        raise NameError(\n            f\"{variable_name} is missing.\\n\"\n            \"Please run the preprocessing Step 4 first.\"\n        )\n\n    print(f\"✓ {variable_name}\")\n\n\n# ============================================================\n# 15.3 — LINEAR REGRESSION\n# ============================================================\n# Linear Regression was the baseline model from Step 5.\n#\n# We reconstruct it if the previous Python object is unavailable.\n#\n# Formula:\n#\n#     y_hat = Xβ\n#\n# The model is trained on the same processed training data.\n\nif \"linear_regression_model\" in globals():\n\n    linear_model_final = (\n        linear_regression_model\n    )\n\n    print(\n        \"\\n✓ Using existing Linear Regression model.\"\n    )\n\nelse:\n\n    linear_model_final = LinearRegression()\n\n    linear_model_final.fit(\n        X_train_processed,\n        y_train\n    )\n\n    print(\n        \"\\n✓ Linear Regression reconstructed.\"\n    )\n\n\n# ============================================================\n# 15.4 — DECISION TREE\n# ============================================================\n# Step 10 selected:\n#\n#     max_depth = 6\n#\n# The selected tree had:\n#\n#     depth = 6\n#     leaves = 57\n#\n# We reconstruct it if necessary.\n\nif \"selected_tree\" in globals():\n\n    tree_model_final = selected_tree\n\n    print(\n        \"✓ Using existing Decision Tree model.\"\n    )\n\nelse:\n\n    tree_model_final = DecisionTreeRegressor(\n        max_depth=6,\n        random_state=42\n    )\n\n    tree_model_final.fit(\n        X_train_processed,\n        y_train\n    )\n\n    print(\n        \"✓ Decision Tree reconstructed.\"\n    )\n\n\n# ============================================================\n# 15.5 — RANDOM FOREST\n# ============================================================\n# Step 11 selected the following exploratory configuration:\n#\n#     n_estimators = 10\n#     max_depth = 12\n#     min_samples_leaf = 1\n#\n# This configuration produced approximately:\n#\n#     MAE  ≈ ₹1,048,280\n#     RMSE ≈ ₹1,375,452\n#     R²   ≈ 0.625712\n#\n# We reconstruct the model directly if its previous object\n# is unavailable.\n\nif \"selected_rf\" in globals():\n\n    rf_model_final = selected_rf\n\n    print(\n        \"✓ Using existing Random Forest model.\"\n    )\n\nelse:\n\n    rf_model_final = RandomForestRegressor(\n        n_estimators=10,\n        max_depth=12,\n        min_samples_leaf=1,\n        random_state=42,\n        n_jobs=-1\n    )\n\n    rf_model_final.fit(\n        X_train_processed,\n        y_train\n    )\n\n    print(\n        \"✓ Random Forest reconstructed.\"\n    )\n\n\n# ============================================================\n# 15.6 — GRADIENT BOOSTING\n# ============================================================\n# Step 13 selected:\n#\n#     n_estimators = 300\n#     learning_rate = 0.05\n#     max_depth = 2\n#\n# Previously obtained test performance:\n#\n#     MAE  ≈ ₹967,705\n#     RMSE ≈ ₹1,321,276\n#     R²   ≈ 0.654615\n#\n# We reconstruct this model if the previous object is missing.\n\nif \"best_gb_model\" in globals():\n\n    gb_model_final = best_gb_model\n\n    print(\n        \"✓ Using existing Gradient Boosting model.\"\n    )\n\nelse:\n\n    gb_model_final = GradientBoostingRegressor(\n        n_estimators=300,\n        learning_rate=0.05,\n        max_depth=2,\n        random_state=42\n    )\n\n    gb_model_final.fit(\n        X_train_processed,\n        y_train\n    )\n\n    print(\n        \"✓ Gradient Boosting reconstructed.\"\n    )\n\n\n# ============================================================\n# 15.7 — XGBOOST\n# ============================================================\n# Step 14 selected this configuration using\n# RandomizedSearchCV:\n#\n#     subsample        = 0.6\n#     reg_lambda       = 5\n#     reg_alpha        = 0\n#     n_estimators     = 100\n#     min_child_weight = 3\n#     max_depth        = 4\n#     learning_rate    = 0.1\n#     colsample_bytree = 0.6\n#\n# Best CV RMSE:\n#\n#     ₹1,010,276.29\n#\n# Final test:\n#\n#     MAE  = ₹965,047.75\n#     RMSE = ₹1,328,523.54\n#     R²   = 0.650816\n\nif \"best_xgb_model\" in globals():\n\n    xgb_model_final = best_xgb_model\n\n    print(\n        \"✓ Using existing XGBoost model.\"\n    )\n\nelse:\n\n    xgb_model_final = XGBRegressor(\n        n_estimators=100,\n        learning_rate=0.1,\n        max_depth=4,\n        min_child_weight=3,\n        subsample=0.6,\n        colsample_bytree=0.6,\n        reg_alpha=0,\n        reg_lambda=5,\n        objective=\"reg:squarederror\",\n        tree_method=\"hist\",\n        random_state=42,\n        n_jobs=-1\n    )\n\n    xgb_model_final.fit(\n        X_train_processed,\n        y_train\n    )\n\n    print(\n        \"✓ XGBoost reconstructed.\"\n    )\n\n\n# ============================================================\n# 15.8 — FINAL MODEL DICTIONARY\n# ============================================================\n# All five models are now guaranteed to exist.\n#\n# From this point onward, every model is evaluated using the\n# exact same code.\n\nmodels = {\n\n    \"Linear Regression\":\n        linear_model_final,\n\n    \"Decision Tree\":\n        tree_model_final,\n\n    \"Random Forest\":\n        rf_model_final,\n\n    \"Gradient Boosting\":\n        gb_model_final,\n\n    \"XGBoost\":\n        xgb_model_final\n}\n\n\nprint(\"\\n15.8 — FINAL MODEL LIST\")\nprint(\"=\" * 75)\n\nfor model_name, model in models.items():\n\n    print(\n        f\"✓ {model_name:<22} \"\n        f\"→ {type(model).__name__}\"\n    )\n\n\n# ============================================================\n# 15.9 — GENERATE TRAINING AND TEST PREDICTIONS\n# ============================================================\n# Every model receives:\n#\n#     X_train_processed\n#     X_test_processed\n#\n# This lets us compare:\n#\n#     training performance\n#     unseen test performance\n\npredictions = {}\n\n\nfor model_name, model in models.items():\n\n    train_pred = model.predict(\n        X_train_processed\n    )\n\n    test_pred = model.predict(\n        X_test_processed\n    )\n\n    predictions[model_name] = {\n\n        \"train\": train_pred,\n\n        \"test\": test_pred\n    }\n\n\nprint(\n    \"\\n15.9 — Predictions generated successfully.\"\n)\n\n\n# ============================================================\n# 15.10 — TRAIN VS TEST METRICS\n# ============================================================\n# We calculate:\n#\n#     MAE\n#     RMSE\n#     R²\n#\n# for both training and test data.\n\nperformance_rows = []\n\n\nfor model_name in models:\n\n    train_pred = predictions[\n        model_name\n    ][\"train\"]\n\n    test_pred = predictions[\n        model_name\n    ][\"test\"]\n\n\n    # Training metrics\n\n    train_mae = mean_absolute_error(\n        y_train,\n        train_pred\n    )\n\n    train_mse = mean_squared_error(\n        y_train,\n        train_pred\n    )\n\n    train_rmse = np.sqrt(\n        train_mse\n    )\n\n    train_r2 = r2_score(\n        y_train,\n        train_pred\n    )\n\n\n    # Test metrics\n\n    test_mae = mean_absolute_error(\n        y_test,\n        test_pred\n    )\n\n    test_mse = mean_squared_error(\n        y_test,\n        test_pred\n    )\n\n    test_rmse = np.sqrt(\n        test_mse\n    )\n\n    test_r2 = r2_score(\n        y_test,\n        test_pred\n    )\n\n\n    performance_rows.append({\n\n        \"Model\":\n            model_name,\n\n        \"Train MAE\":\n            train_mae,\n\n        \"Test MAE\":\n            test_mae,\n\n        \"Train RMSE\":\n            train_rmse,\n\n        \"Test RMSE\":\n            test_rmse,\n\n        \"Train R²\":\n            train_r2,\n\n        \"Test R²\":\n            test_r2\n    })\n\n\nperformance_df = pd.DataFrame(\n    performance_rows\n)\n\n\nprint(\"\\n15.10 — TRAIN VS TEST PERFORMANCE\")\nprint(\"=\" * 110)\n\n\ndisplay(\n    performance_df.style.format({\n\n        \"Train MAE\":\n            \"₹{:,.2f}\",\n\n        \"Test MAE\":\n            \"₹{:,.2f}\",\n\n        \"Train RMSE\":\n            \"₹{:,.2f}\",\n\n        \"Test RMSE\":\n            \"₹{:,.2f}\",\n\n        \"Train R²\":\n            \"{:.6f}\",\n\n        \"Test R²\":\n            \"{:.6f}\"\n    })\n)\n\n\n# ============================================================\n# 15.11 — GENERALIZATION GAP\n# ============================================================\n# R² gap:\n#\n#     Train R² - Test R²\n#\n# A large positive value indicates that the model performs\n# substantially better on training data than unseen data.\n#\n# This is one signal of overfitting.\n\ngap_df = performance_df[\n    [\n        \"Model\",\n        \"Train R²\",\n        \"Test R²\"\n    ]\n].copy()\n\n\ngap_df[\"R² Gap\"] = (\n    gap_df[\"Train R²\"] -\n    gap_df[\"Test R²\"]\n)\n\n\ngap_df = gap_df.sort_values(\n    \"R² Gap\",\n    ascending=False\n)\n\n\nprint(\"\\n15.11 — GENERALIZATION GAP\")\nprint(\"=\" * 80)\n\n\ndisplay(\n    gap_df.style.format({\n\n        \"Train R²\":\n            \"{:.6f}\",\n\n        \"Test R²\":\n            \"{:.6f}\",\n\n        \"R² Gap\":\n            \"{:.6f}\"\n    })\n)\n\n\n# ============================================================\n# 15.12 — RESIDUAL ANALYSIS\n# ============================================================\n# Residual:\n#\n#     actual - predicted\n#\n# Positive residual:\n#     model underestimated price.\n#\n# Negative residual:\n#     model overestimated price.\n\nresiduals = {}\n\n\nfor model_name in models:\n\n    residuals[model_name] = (\n        y_test.to_numpy() -\n        predictions[model_name][\"test\"]\n    )\n\n\nresidual_rows = []\n\n\nfor model_name, residual in residuals.items():\n\n    residual_rows.append({\n\n        \"Model\":\n            model_name,\n\n        \"Mean Residual\":\n            np.mean(residual),\n\n        \"Median Residual\":\n            np.median(residual),\n\n        \"Std Residual\":\n            np.std(residual),\n\n        \"Minimum Residual\":\n            np.min(residual),\n\n        \"Maximum Residual\":\n            np.max(residual)\n    })\n\n\nresidual_summary_df = pd.DataFrame(\n    residual_rows\n)\n\n\nprint(\"\\n15.12 — RESIDUAL STATISTICS\")\nprint(\"=\" * 105)\n\n\ndisplay(\n    residual_summary_df.style.format({\n\n        \"Mean Residual\":\n            \"₹{:,.2f}\",\n\n        \"Median Residual\":\n            \"₹{:,.2f}\",\n\n        \"Std Residual\":\n            \"₹{:,.2f}\",\n\n        \"Minimum Residual\":\n            \"₹{:,.2f}\",\n\n        \"Maximum Residual\":\n            \"₹{:,.2f}\"\n    })\n)\n\n\n# ============================================================\n# 15.13 — ACTUAL VS PREDICTED\n# ==============