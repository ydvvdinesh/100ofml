ations discovered during tuning.\n\nfinal_model_comparison = pd.DataFrame([\n    {\n        \"Model\": \"Linear Regression\",\n        \"Alpha\": \"None\",\n        \"RMSE\": linear_rmse,\n        \"R²\": linear_r2\n    },\n    {\n        \"Model\": \"Best Ridge\",\n        \"Alpha\": final_ridge_alpha,\n        \"RMSE\": final_ridge_rmse,\n        \"R²\": final_ridge_r2\n    },\n    {\n        \"Model\": \"Best Lasso\",\n        \"Alpha\": final_lasso_alpha,\n        \"RMSE\": final_lasso_rmse,\n        \"R²\": final_lasso_r2\n    }\n])\n\nprint(\"\\n===== FINAL MODEL COMPARISON =====\")\nprint(\n    final_model_comparison.to_string(index=False)\n)\n\n\n# ============================================================\n# 9.16 — FINAL STEP SUMMARY\n# ============================================================\n\n# OBJECTIVE:\n# Print the key findings from the entire hyperparameter tuning\n# experiment.\n\nprint(\"\\n\")\nprint(\"=\" * 70)\nprint(\"STEP 9 — HYPERPARAMETER TUNING SUMMARY\")\nprint(\"=\" * 70)\n\nprint(\"\\nAlpha values tested:\")\nprint(alpha_values)\n\nprint(\"\\nBest Ridge alpha:\", final_ridge_alpha)\nprint(f\"Best Ridge RMSE: ₹{final_ridge_rmse:,.2f}\")\nprint(f\"Best Ridge R²:   {final_ridge_r2:.6f}\")\n\nprint(\"\\nBest Lasso alpha:\", final_lasso_alpha)\nprint(f\"Best Lasso RMSE: ₹{final_lasso_rmse:,.2f}\")\nprint(f\"Best Lasso R²:   {final_lasso_r2:.6f}\")\nprint(\n    \"Best Lasso zero coefficients:\",\n    final_lasso_zero_coefficients\n)\n\nprint(\"\\n\" + \"=\" * 70)\nprint(\"STEP 9 COMPLETE\")\nprint(\"=\" * 70)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-02T12:59:10.484056Z","iopub.execute_input":"2026-10-02T12:59:10.485015Z","iopub.status.idle":"2026-10-02T12:59:12.117389Z","shell.execute_reply.started":"2026-10-02T12:59:10.484977Z","shell.execute_reply":"2026-10-02T12:59:12.116626Z"}},"outputs":[{"name":"stdout","text":"===== ALPHA VALUES =====\n[0.001, 0.01, 0.1, 1, 10, 100, 1000]\n\n===== RIDGE HYPERPARAMETER 