":{"text/plain":"<Figure size 1000x700 with 1 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 800x600 with 1 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"\n===== GRADIENT BOOSTING PREDICTIONS =====\n Actual Price  Predicted Price         Error  Absolute Error\n      4060000     4.688688e+06 -6.286879e+05    6.286879e+05\n      6650000     7.126465e+06 -4.764654e+05    4.764654e+05\n      3710000     3.602705e+06  1.072950e+05    1.072950e+05\n      6440000     4.547259e+06  1.892741e+06    1.892741e+06\n      2800000     3.546230e+06 -7.462303e+05    7.462303e+05\n      4900000     3.977391e+06  9.226091e+05    9.226091e+05\n      5250000     6.026431e+06 -7.764310e+05    7.764310e+05\n      4543000     6.071430e+06 -1.528430e+06    1.528430e+06\n      2450000     3.141283e+06 -6.912832e+05    6.912832e+05\n      3353000     3.006168e+06  3.468319e+05    3.468319e+05\n\n\n================================================================================\nSTEP 13 — GRADIENT BOOSTING REGRESSION SUMMARY\n================================================================================\n\n----- SELECTED MODEL -----\nNumber of estimators: 300\nLearning rate: 0.05\nMaximum tree depth: 2\n\n----- TRAINING PERFORMANCE -----\nTrain RMSE: ₹778,138.85\nTrain R²:   0.803625\n\n----- TEST PERFORMANCE -----\nTest MAE:  ₹967,704.78\nTest RMSE: ₹1,321,276.07\nTest R²:   0.654615\n\n----- MODEL COMPARISON -----\n            Model          MAE         RMSE       R²\nLinear Regression 9.700434e+05 1.324507e+06 0.652924\n    Decision Tree 1.220774e+06 1.599875e+06 0.493607\n    Random Forest 1.048280e+06 1.375452e+06 0.625712\nGradient Boosting 9.677048e+05 1.321276e+06 0.654615\n\n----- MOST IMPORTANT FEATURE -----\nFeature: remainder__area\nImportance: 0.4533119247429509\n\n================================================================================\nSTEP 13 COMPLETE\n================================================================================\n","output_type":"stream"}],"execution_count":64},{"cell_type":"code","source":"# OBJECTIVE: Train, understand, tune, and evaluate an XGBoost regression model for house-price prediction using cross-validation while keeping the test set untouched until final evaluation.\n\n# ============================================================\n# STEP 14 — XGBOOST REGRESSION\n# ============================================================\n\n# ------------------------------------------------------------\n# 14.1 — IMPORTS AND DATA CHECK\n# ------------------------------------------------------------\n# XGBoost is a gradient-boosted decision-tree implementation.\n# We use XGBRegressor because our target variable, price, is continuous.\n#\n# Important:\n# X_train_processed / X_test_processed were created in Step 4.\n# They contain:\n#   - one-hot encoded categorical variables\n#   - numerical variables\n#\n# The test set will NOT be used for hyperparameter selection.\n# Hyperparameters will be selected using 5-fold cross-validation\n# only on the training data.\n\nimport numpy as np\nimport pandas as pd\n\nfrom xgboost import XGBRegressor\n\nfrom sklearn.model_selection import (\n    KFold,\n    cross_val_score,\n    RandomizedSearchCV\n)\n\nfrom sklearn.metrics import (\n    mean_absolute_error,\n    mean_squared_error,\n    r2_score\n)\n\nprint(\"XGBoost imported successfully.\")\nprint(\"Training shape :\", X_train_processed.shape)\nprint(\"Testing shape  :\", X_test_processed.shape)\nprint(\"Number of features:\", X_train_processed.shape[1])\n\n\n# ============================================================\n# 14.2 — UNDERSTANDING XGBOOST\n# ============================================================\n# Gradient Boosting builds trees sequentially.\n#\n# Tree 1 makes predictions.\n# Tree 2 focuses on correcting Tree 1's errors.\n# Tree 3 focuses on remaining errors.\n# ...\n#\n# XGBoost follows this boosting idea but adds:\n#   - regularization\n#   - efficient tree construction\n#   - shrinkage through learning_rate\n#   - row subsampling\n#   - feature subsampling\n#   - efficient computation\n#\n# The final prediction is approximately:\n#\n#     Prediction = Tree_1 + Tree_2 + ... + Tree_n\n#\n# learning_rate controls how strongly each new tree contributes.\n#\n# Smaller learning_rate:\n#     slower learning\n#     usually requires more trees\n#\n# Larger learning_rate:\n#     faster learning\n#     can overfit more easily\n#\n# max_depth controls the complexity of each tree.\n#\n# More depth:\n#     more complex interactions\n#     higher overfitting risk\n#\n# Less depth:\n#     simpler trees\n#     stronger regularization\n#\n# subsample controls the fraction of training rows used by\n# each boosting tree.\n#\n# colsample_bytree controls the fraction of features considered\n# by each tree.\n\n\n# ============================================================\n# 14.3 — BASELINE XGBOOST MODEL\n# ============================================================\n# Start with a reasonable baseline rather than immediately\n# searching hundreds of configurations.\n#\n# tree_method=\"hist\":\n#     Uses XGBoost's histogram-based tree construction.\n#     It is efficient and works well for this dataset.\n#\n# objective=\"reg:squarederror\":\n#     Standard squared-error objective for regression.\n#\n# n_jobs=-1:\n#     Allows XGBoost to use available CPU cores.\n\nxgb_baseline = XGBRegressor(\n    n_estimators=200,\n    learning_rate=0.05,\n    max_depth=3,\n    min_child_weight=1,\n    subsample=1.0,\n    colsample_bytree=1.0,\n    reg_alpha=0,\n    reg_lambda=1,\n    objective=\"reg:squarederror\",\n    tree_method=\"hist\",\n    random_state=42,\n    n_jobs=-1\n)\n\nxgb_baseline.fit(\n    X_train_processed,\n    y_train\n)\n\nprint(\"\\nBaseline XGBoost trained successfully.\")\n\n\n# ============================================================\n# 14.4 — BASELINE CROSS-VALIDATION\n# ============================================================\n# We use 5-fold CV on the training set.\n#\n# RMSE is used because it is directly interpretable in the\n# same unit as house price.\n#\n# cross_val_score returns negative RMSE because sklearn's\n# scoring convention treats higher scores as better.\n#\n# Therefore:\n#\n#     RMSE = -mean(CV scores)\n\ncv = KFold(\n    n_splits=5,\n    shuffle=True,\n    random_state=42\n)\n\nbaseline_cv_scores = cross_val_score(\n    xgb_baseline,\n    X_train_processed,\n    y_train,\n    cv=cv,\n    scoring=\"neg_root_mean_squared_error\",\n    n_jobs=-1\n)\n\nbaseline_cv_rmse = -baseline_cv_scores\n\nprint(\"\\nBaseline XGBoost — 5-Fold CV\")\nprint(\"-\" * 50)\n\nfor fold, score in enumerate(baseline_cv_rmse, start=1):\n    print(f\"Fold {fold} RMSE: ₹{score:,.2f}\")\n\nprint(f\"\\nMean CV RMSE: ₹{baseline_cv_rmse.mean():,.2f}\")\nprint(f\"CV Std Dev  : ₹{baseline_cv_rmse.std():,.2f}\")\n\n\n# ============================================================\n# 14.5 — CONTROLLED EXPERIMENT: NUMBER OF TREES\n# ============================================================\n# n_estimators = number of boosting trees.\n#\n# Too few trees:\n#     model may underfit.\n#\n# Too many trees:\n#     model can become unnecessarily complex, especially when\n#     learning_rate is not sufficiently small.\n#\n# We compare several values using CV instead of the test set.\n\nn_estimators_values = [50, 100, 200, 300, 500]\n\ntree_results = []\n\nfor n in n_estimators_values:\n\n    model = XGBRegressor(\n        n_estimators=n,\n        learning_rate=0.05,\n        max_depth=3,\n        min_child_weight=1,\n        subsample=1.0,\n        colsample_bytree=1.0,\n        reg_alpha=0,\n        reg_lambda=1,\n        objective=\"reg:squarederror\",\n        tree_method=\"hist\",\n        random_state=42,\n        n_jobs=-1\n    )\n\n    scores = cross_val_score(\n        model,\n        X_train_processed,\n        y_train,\n        cv=cv,\n        scoring=\"neg_root_mean_squared_error\",\n        n_jobs=-1\n    )\n\n    tree_results.append({\n        \"n_estimators\": n,\n        \"CV RMSE\": -scores.mean()\n    })\n\ntree_results_df = pd.DataFrame(tree_results)\n\nprint(\"\\n14.5 — Number of Trees Experiment\")\nprint(tree_results_df.to_string(index=False))\n\n\n# ============================================================\n# 14.6 — CONTROLLED EXPERIMENT: LEARNING RATE\n# ============================================================\n# learning_rate determines how much each new tree changes\n# the overall model.\n#\n# Typical relationship:\n#\n# smaller learning_rate\n#          ↓\n# more trees required\n#\n# larger learning_rate\n#          ↓\n# fewer trees required\n#\n# We keep other parameters fixed so that we can isolate\n# the effect of learning_rate.\n\nlearning_rate_values = [0.01, 0.03, 0.05, 0.10, 0.20]\n\nlearning_rate_results = []\n\nfor lr in learning_rate_values:\n\n    model = XGBRegressor(\n        n_estimators=300,\n        learning_rate=lr,\n        max_depth=3,\n        min_child_weight=1,\n        subsample=1.0,\n        colsample_bytree=1.0,\n        reg_alpha=0,\n        reg_lambda=1,\n        objective=\"reg:squarederror\",\n        tree_method=\"hist\",\n        random_state=42,\n        n_jobs=-1\n    )\n\n    scores = cross_val_score(\n        model,\n        X_train_processed,\n        y_train,\n        cv=cv,\n        scoring=\"neg_root_mean_squared_error\",\n        n_jobs=-1\n    )\n\n    learning_rate_results.append({\n        \"learning_rate\": lr,\n        \"CV RMSE\": -scores.mean()\n    })\n\nlearning_rate_results_df = pd.DataFrame(learning_rate_results)\n\nprint(\"\\n14.6 — Learning Rate Experiment\")\nprint(learning_rate_results_df.to_string(index=False))\n\n\n# ============================================================\n# 14.7 — CONTROLLED EXPERIMENT: TREE DEPTH\n# ============================================================\n# max_depth determines how deep each individual tree can grow.\n#\n# Shallow trees:\n#     simpler patterns\n#     lower variance\n#\n# Deep trees:\n#     more complex interactions\n#     higher variance / overfitting risk\n#\n# We test several depths while keeping the remaining\n# parameters fixed.\n\ndepth_values = [2, 3, 4, 5, 6]\n\ndepth_results = []\n\nfor depth in depth_values:\n\n    model = XGBRegressor(\n        n_estimators=300,\n        learning_rate=0.05,\n        max_depth=depth,\n        min_child_weight=1,\n        subsample=1.0,\n        colsample_bytree=1.0,\n        reg_alpha=0,\n        reg_lambda=1,\n        objective=\"reg:squarederror\",\n        tree_method=\"hist\",\n        random_state=42,\n        n_jobs=-1\n    )\n\n    scores = cross_val_score(\n        model,\n        X_train_processed,\n        y_train,\n        cv=cv,\n        scoring=\"neg_root_mean_squared_error\",\n        n_jobs=-1\n    )\n\n    depth_results.append({\n        \"max_depth\": depth,\n        \"CV RMSE\": -scores.mean()\n    })\n\ndepth_results_df = pd.DataFrame(depth_results)\n\nprint(\"\\n14.7 — Tree Depth Experiment\")\nprint(depth_results_df.to_string(index=False))\n\n\n# ============================================================\n# 14.8 — CONTROLLED EXPERIMENT: SUBSAMPLING\n# ============================================================\n# subsample controls how many training rows are sampled for\n# each boosting tree.\n#\n# Example:\n#     subsample=0.8\n#\n# means each tree uses approximately 80% of the training rows.\n#\n# This introduces randomness and can reduce overfitting.\n\nsubsample_values = [0.6, 0.8, 1.0]\n\nsubsample_results = []\n\nfor subsample in subsample_values:\n\n    model = XGBRegressor(\n        n_estimators=300,\n        learning_rate=0.05,\n        max_depth=3,\n        min_child_weight=1,\n        subsample=subsample,\n        colsample_bytree=1.0,\n        reg_alpha=0,\n        reg_lambda=1,\n        objective=\"reg:squarederror\",\n        tree_method=\"hist\",\n        random_state=42,\n        n_jobs=-1\n    )\n\n    scores = cross_val_score(\n        model,\n        X_train_processed,\n        y_train,\n        cv=cv,\n        scoring=\"neg_root_mean_squared_error\",\n        n_jobs=-1\n    )\n\n    subsample_results.append({\n        \"subsample\": subsample,\n        \"CV RMSE\": -scores.mean()\n    })\n\nsubsample_results_df = pd.DataFrame(subsample_results)\n\nprint(\"\\n14.8 — Row Subsampling Experiment\")\nprint(subsample_results_df.to_string(index=False))\n\n\n# ============================================================\n# 14.9 — RANDOMIZED SEARCH WITH 5-FOLD CROSS-VALIDATION\n# ============================================================\n# XGBoost has many interacting hyperparameters.\n#\n# Exhaustively testing every combination can become expensive.\n#\n# RandomizedSearchCV samples a specified number of parameter\n# combinations instead.\n#\n# This gives us a practical introduction to efficient\n# hyperparameter optimization.\n#\n# IMPORTANT:\n# The test set is NOT supplied to RandomizedSearchCV.\n#\n# Therefore the test set remains untouched for final evaluation.\n\nxgb_for_search = XGBRegressor(\n    objective=\"reg:squarederror\",\n    tree_method=\"hist\",\n    random_state=42,\n    n_jobs=-1\n)\n\nxgb_param_distributions = {\n    \"n_estimators\": [100, 200, 300, 400, 500],\n    \"learning_rate\": [0.01, 0.03, 0.05, 0.08, 0.10],\n    \"max_depth\": [2, 3, 4, 5, 6],\n    \"min_child_weight\": [1, 3, 5, 10],\n    \"subsample\": [0.6, 0.8, 1.0],\n    \"colsample_bytree\": [0.6, 0.8, 1.0],\n    \"reg_alpha\": [0, 0.01, 0.1, 1],\n    \"reg_lambda\": [1, 5, 10]\n}\n\nrandom_search = RandomizedSearchCV(\n    estimator=xgb_for_search,\n    param_distributions=xgb_param_distributions,\n    n_iter=25,\n    scoring=\"neg_root_mean_squared_error\",\n    cv=cv,\n    random_state=42,\n    n_jobs=-1,\n    verbose=1,\n    refit=True\n)\n\nprint(\"\\n14.9 — Starting RandomizedSearchCV\")\nprint(\"25 parameter combinations × 5 folds = 125 model fits\")\n\nrandom_search.fit(\n    X_train_processed,\n    y_train\n)\n\nbest_xgb_model = random_search.best_estimator_\n\nprint(\"\\nRandomizedSearchCV completed.\")\n\n\n# ============================================================\n# 14.10 — BEST XGBOOST HYPERPARAMETERS\n# ============================================================\n# best_params_ contains the parameter combination that produced\n# the best mean cross-validation score.\n#\n# Because scoring uses negative RMSE, the highest score means\n# the lowest RMSE.\n\nprint(\"\\n14.10 — Best XGBoost Hyperparameters\")\nprint(\"-\" * 60)\n\nfor parameter, value in random_search.best_params_.items():\n    print(f\"{parameter}: {value}\")\n\nprint(\n    f\"\\nBest CV RMSE: \"\n    f\"₹{-random_search.best_score_:,.2f}\"\n)\n\n\n# ============================================================\n# 14.11 — FINAL XGBOOST EVALUATION ON TEST SET\n# ============================================================\n# NOW we evaluate the selected model on the untouched test set.\n#\n# This is the important final evaluation for Step 14.\n#\n# The test set was not used during RandomizedSearchCV.\n\ny_test_pred_xgb = best_xgb_model.predict(X_test_processed)\n\nxgb_test_mae = mean_absolute_error(\n    y_test,\n    y_test_pred_xgb\n)\n\nxgb_test_mse = mean_squared_error(\n    y_test,\n    y_test_pred_xgb\n)\n\nxgb_test_rmse = np.sqrt(xgb_test_mse)\n\nxgb_test_r2 = r2_score(\n    y_test,\n    y_test_pred_xgb\n)\n\nprint(\"\\n14.11 — FINAL XGBOOST TEST RESULTS\")\nprint(\"=\" * 60)\n\nprint(f\"MAE  : ₹{xgb_test_mae:,.2f}\")\nprint(f\"MSE  : {xgb_test_mse:,.2f}\")\nprint(f\"RMSE : ₹{xgb_test_rmse:,.2f}\")\nprint(f\"R²   : {xgb_test_r2:.6f}\")\n\n\n# ============================================================\n# 14.12 — FEATURE IMPORTANCE\n# ============================================================\n# XGBoost provides feature_importances_.\n#\n# These values indicate how much each feature contributed to\n# the tree-building process according to XGBoost's importance\n# calculation.\n#\n# IMPORTANT:\n# Feature importance is NOT causal importance.\n# A high importance does not mean that the feature alone\n# causes the target to increase.\n\nxgb_feature_importance = pd.DataFrame({\n    \"Feature\": feature_names,\n    \"Importance\": best_xgb_model.feature_importances_\n})\n\nxgb_feature_importance = (\n    xgb_feature_importance\n    .sort_values(\"Importance\", ascending=False)\n    .reset_index(drop=True)\n)\n\nprint(\"\\n14.12 — XGBoost Feature Importance\")\nprint(\"=\" * 60)\nprint(xgb_feature_importance.to_string(index=False))\n\n\n# ============================================================\n# 14.13 — COMPARE XGBOOST WITH PREVIOUS MODELS\n# ============================================================\n# We compare the final XGBoost model against the models already\n# trained during this project.\n#\n# Previous test results:\n#\n# Linear Regression:\n#     MAE  = ₹970,043.40\n#     RMSE = ₹1,324,506.96\n#     R²   = 0.652924\n#\n# Decision Tree:\n#     MAE  = ₹1,220,773.65\n#     RMSE = ₹1,599,874.75\n#     R²   = 0.493607\n#\n# Random Forest:\n#     MAE  = ₹1,048,279.73\n#     RMSE = ₹1,375,451.54\n#     R²   = 0.625712\n#\n# Gradient Boosting:\n#     MAE  = ₹967,704.78\n#     RMSE = ₹1,321,276.07\n#     R²   = 0.654615\n#\n# NOTE:\n# Gradient Boosting's configuration was selected through\n# exploratory test-set experiments in Step 13.\n#\n# XGBoost in this step uses CV-based hyperparameter selection,\n# so the comparison should be interpreted with that methodology\n# difference in mind.\n\nmodel_comparison = pd.DataFrame({\n    \"Model\": [\n        \"Linear Regression\",\n        \"Decision Tree\",\n        \"Random Forest\",\n        \"Gradient Boosting\",\n        \"XGBoost\"\n    ],\n    \"MAE\": [\n        970043.403920,\n        1220773.65,\n        1048279.73,\n        967704.78,\n        xgb_test_mae\n    ],\n    \"RMSE\": [\n        1324506.96,\n        1599874.75,\n        13754