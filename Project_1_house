\n\n\n# Create the preprocessing transformer.\n#\n# ColumnTransformer allows us to apply different transformations\n# to different groups of columns.\n#\n# (\"categorical\", OneHotEncoder(...), categorical_features)\n#     → apply One-Hot Encoding to categorical columns.\n#\n# handle_unknown=\"ignore\"\n#     → if a category appears in the test data that was not seen\n#       during training, the encoder will not produce an error.\n#\n# remainder=\"passthrough\"\n#     → numerical columns are kept as they are instead of being removed.\npreprocessor = ColumnTransformer(\n    transformers=[\n        (\n            \"categorical\",\n            OneHotEncoder(handle_unknown=\"ignore\"),\n            categorical_features\n        )\n    ],\n    remainder=\"passthrough\"\n)\n\n\n# Display the preprocessing object.\nprint(\"===== PREPROCESSOR =====\")\nprint(preprocessor)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-02T12:32:33.788281Z","iopub.execute_input":"2026-10-02T12:32:33.788917Z","iopub.status.idle":"2026-10-02T12:32:34.070675Z","shell.execute_reply.started":"2026-10-02T12:32:33.788885Z","shell.execute_reply":"2026-10-02T12:32:34.069692Z"}},"outputs":[{"name":"stdout","text":"===== PREPROCESSOR =====\nColumnTransformer(remainder='passthrough',\n                  transformers=[('categorical',\n                                 OneHotEncoder(handle_unknown='ignore'),\n                                 ['mainroad', 'guestroom', 'basement',\n                                  'hotwaterheating', 'airconditioning',\n                                  'prefarea', 'furnishingstatus'])])\n","output_type":"stream"}],"execution_count":23},{"cell_type":"code","source":"# ============================================================\n# STEP 4 — FEATURE ENGINEERING & PREPROCESSING\n# 4.5 — Fit Preprocessing Only on Training Data\n# ============================================================\n\n# OBJECTIVE: Learn the encoding structure only from the training\