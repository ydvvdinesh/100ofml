 np.ones((X_test_scratch.shape[0], 1)),\n    X_test_scratch\n])\n\n\n# Calculate predictions using matrix multiplication.\n#\n# Mathematical equation:\n#\n# ŷ = Xβ\n#\n# X → test feature matrix\n# β → coefficients learned from training data\n#\n# @ performs matrix multiplication in Python/NumPy.\ny_pred_scratch = (\n    X_test_with_intercept @ beta\n)\n\n\n# Display the first 10 predictions.\nprint(\"===== FROM-SCRATCH PREDICTIONS =====\")\nprint(y_pred_scratch[:10])\n\n\n# Display the total number of predictions.\nprint(\"\\nNumber of predictions:\", len(y_pred_scratch))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-02T12:51:40.293012Z","iopub.execute_input":"2026-10-02T12:51:40.29345Z","iopub.status.idle":"2026-10-02T12:51:40.299693Z","shell.execute_reply.started":"2026-10-02T12:51:40.293423Z","shell.execute_reply":"2026-10-02T12:51:40.298671Z"}},"outputs":[{"name":"stdout","text":"===== FROM-SCRATCH PREDICTIONS =====\n[5164653.90033997 7224722.29802199 3109863.24240359 4612075.32722585\n 3294646.25725976 3532275.09556592 5611774.56836517 6368145.98732744\n 2722856.95690004 2629405.61585798]\n\nNumber of predictions: 109\n","output_type":"stream"}],"execution_count":51},{"cell_type":"code","source":"# ============================================================\n# STEP 7 — LINEAR REGRESSION FROM SCRATCH\n# 7.7 + 7.8 — Calculate MSE, RMSE and R² From Scratch\n# ============================================================\n\n# OBJECTIVE: Independently calculate predictions and regression\n# evaluation metrics from our from-scratch Linear Regression model\n# without depending on mse_scratch or other variables from previous cells.\n\n\nimport numpy as np\n\n\n# ------------------------------------------------------------\n# PART 1 — Prepare the Training Data\n# ------------------------------------------------------------\n\n# Convert the processed training DataFrame into a NumPy array.\n#\n# NumPy arrays allow us to perform matrix operations such as\n# matrix multiplication and pseudoinverse calculations.\nX_train_scratch = X_train_processed_df.values\n\n\n# Convert the training target prices into a NumPy array.\ny_train_scratch = y_train.values\n\n\n# ------------------------------------------------------------\n# PART 2 — Add the Intercept\n# ------------------------------------------------------------\n\n# Create a column of ones for the intercept β₀.\n#\n# The number of rows must be equal to the number of training houses.\nintercept_column = np.ones(\n    (X_train_scratch.shape[0], 1)\n)\n\n\n# Add the intercept column to the beginning of the feature matrix.\n#\n# The resulting structure is:\n#\n# [1, x1, x2, x3, ...]\n#\n# The first column allows us to learn the intercept.\nX_train_with_intercept = np.hstack(\n    [intercept_column, X_train_scratch]\n)\n\n\n# ------------------------------------------------------------\n# PART 3 — Calculate Linear Regression Coefficients\n# ------------------------------------------------------------\n\n# Calculate the Moore-Penrose pseudoinverse of X.\n#\n# np.linalg.pinv()\n#     → calculates the pseudoinverse of a matrix.\n#\n# We use this instead of directly calculating an inverse\n# because it is more numerically stable.\nX_pseudo_inverse = np.linalg.pinv(\n    X_train_with_intercept\n)\n\n\n# Calculate the Linear Regression coefficients.\n#\n# Mathematical formula:\n#\n# β = X⁺y\n#\n# X⁺ → pseudoinverse of X\n# y  → actual training prices\n#\n# The first value of beta is the intercept.\n# The remaining values are feature coefficients.\nbeta_scratch = (\n    X_pseudo_inverse @ y_train_scratch\n)\n\n\n# ------------------------------------------------------------\n# PART 4 — Prepare the Test Data\n# ------------------------------------------------------------\n\n# Convert the processed test DataFrame into a NumPy array.\nX_test_scratch = X_test_processed_df.values\n\n\n# Add a column of ones to the test data for the intercept.\nX_test_with_intercept = np.hstack([\n    np.ones((X_test_scratch.shape[0], 1)),\n    X_test_scratch\n])\n\n\n# ------------------------------------------------------------\n# PART 5 — Make Predictions\n# ------------------------------------------------------------\n\n# Calculate predictions using matrix multiplication.\n#\n# Mathematical formula:\n#\n# ŷ = Xβ\n#\n# X → test feature matrix\n# β → coefficients learned from training data\n#\n# @ performs matrix multiplication.\ny_pred_scratch = (\n    X_test_with_intercept @ beta_scratch\n)\n\n\n# ------------------------------------------------------------\n# PART 6 — Calculate Prediction Errors\n# ------------------------------------------------------------\n\n# Calculate the prediction error for every test house.\n#\n# Error = Actual Price - Predicted Price\nerrors_scratch = (\n    y_test.values - y_pred_scratch\n)\n\n\n# Square every error.\n#\n# Squaring makes negative and positive errors positive\n# and gives larger errors more penalty.\nsquared_errors = (\n    errors_scratch ** 2\n)\n\n\n# ------------------------------------------------------------\n# PART 7 — Calculate MSE\n# ------------------------------------------------------------\n\n# Calculate Mean Squared Error.\n#\n# Formula:\n#\n# MSE = (1/n) × Σ(Actual - Predicted)²\n#\n# np.mean() calculates the average squared error.\nmse_scratch = np.mean(\n    squared_errors\n)\n\n\n# ------------------------------------------------------------\n# PART 8 — Calculate RMSE\n# ------------------------------------------------------------\n\n# Calculate Root Mean Squared Error.\n#\n# Formula:\n#\n# RMSE = √MSE\n#\n# RMSE is expressed in the original unit of the target,\n# so here it is measured in rupees.\nrmse_scratch = np.sqrt(\n    mse_scratch\n)\n\n\n# ------------------------------------------------------------\n# PART 9 — Calculate R²\n# ------------------------------------------------------------\n\n# Calculate the total variation in the actual house prices.\n#\n# This measures how much the actual prices vary around\n# their mean value.\ntotal_sum_of_squares = np.sum(\n    (y_test.values - y_test.values.mean()) ** 2\n)\n\n\n# Calculate the total squared prediction error.\nresidual_sum_of_squares = np.sum(\n    (y_test.values - y_pred_scratch) ** 2\n)\n\n\n# Calculate R² using the mathematical formula:\n#\n# R² = 1 - (Residual Sum of Squares /\n#           Total Sum of Squares)\nr2_scratch = (\n    1 -\n    (\n        residual_sum_of_squares /\n        total_sum_of_squares\n    )\n)\n\n\n# ------------------------------------------------------------\n# PART 10 — Display Results\n# ------------------------------------------------------------\n\nprint(\"===== FROM-SCRATCH LINEAR REGRESSION =====\")\n\nprint(f\"MSE:  {mse_scratch:,.2f}\")\n\nprint(f\"RMSE: ₹{rmse_scratch:,.2f}\")\n\nprint(f\"R²:   {r2_scratch:.6f}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-02T12:53:11.403188Z","iopub.execute_input":"2026-10-02T12:53:11.403957Z","iopub.status.idle":"2026-10-02T12:53:11.423738Z","shell.execute_reply.started":"2026-10-02T12:53:11.403925Z","shell.execute_reply":"2026-10-02T12:53:11.422947Z"}},"outputs":[{"name":"stdout","text":"===== FROM-SCRATCH LINEAR REGRESSION =====\nMSE:  1,754,318,687,330.54\nRMSE: ₹1,324,506.96\nR²:   0.652924\n","output_type":"stream"}],"execution_count":54},{"cell_type":"code","source":"# ============================================================\n# STEP 7 — LINEAR REGRESSION FROM SCRATCH\n# 7.9 — Compare From-Scratch Model With sklearn\n# ============================================================\n\n# OBJECTIVE: Verify that our from-scratch Linear Regression produces\n# the same predictions and performance as sklearn's implementation.\n\n\n# Calculate the difference between the predictions\n# from sklearn and our from-scratch implementation.\nprediction_difference = (\n    y_pred - y_pred_scratch\n)\n\n\n# Find the largest absolute difference between\n# the two sets of predictions.\n#\n# If both implementations are equivalent, this number\n# should be extremely close to zero.\nmax_prediction_difference = np.max(\n    np.abs(prediction_difference)\n)\n\n\n# Calculate the average absolute difference between\n# the two prediction sets.\nmean_prediction_difference = np.mean(\n    np.abs(prediction_difference)\n)\n\n\n# Display the comparison results.\nprint(\"===== PREDICTION COMPARISON =====\")\n\nprint(\n    \"Maximum prediction difference:\",\n    max_prediction_difference\n)\n\nprint(\n    \"Mean prediction difference:\",\n    mean_prediction_difference\n)\n\n\n# Compare the evaluation metrics directly.\nprint(\"\\n===== METRIC COMPARISON =====\")\n\nprint(\n    f\"Sklearn MSE:       {mean_squared_error(y_test, y_pred):,.2f}\"\n)\n\nprint(\n    f\"From-Scratch MSE:  {mse_scratch:,.2f}\"\n)\n\nprint(\n    f\"Sklearn RMSE:      ₹{np.sqrt(mean_squared_error(y_test, y_pred)):,.2f}\"\n)\n\nprint(\n    f\"From-Scratch RMSE: ₹{rmse_scratch:,.2f}\"\n)\n\nprint(\n    f\"Sklearn R²:        {r2_score(y_test, y_pred):.6f}\"\n)\n\nprint(\n    f\"From-Scratch R²:   {r2_scratch:.6f}\"\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-02T12:53:55.457817Z","iopub.execute_input":"2026-10-02T12:53:55.458372Z","iopub.status.idle":"2026-10-02T12:53:55.468679Z","shell.execute_reply.started":"2026-10-02T12:53:55.458307Z","shell.execute_reply":"2026-10-02T12:53:55.467757Z"}},"outputs":[{"name":"stdout","text":"===== PREDICTION COMPARISON =====\nMaximum prediction difference: 9.806826710700989e-07\nMean prediction difference: 2.642093790233682e-07\n\n===== METRIC COMPARISON =====\nSklearn MSE:       1,754,318,687,330.70\nFrom-Scratch MSE:  1,754,318,687,330.54\nSklearn RMSE:      ₹1,324,506.96\nFrom-Scratch RMSE: ₹1,324,506.96\nSklearn R²:        0.652924\nFrom-Scratch R²:   0.652924\n","output_type":"stream"}],"execution_count":55},{"cell_type":"code","source":"# ============================================================\n# STEP 7 — LINEAR REGRESSION FROM SCRATCH\n# 7.10 — Verify Learned Coefficients\n# ============================================================\n\n# OBJECTIVE: Compare the coefficients and intercept learned by\n# sklearn with the coefficients obtained directly from the\n# Normal Equation / pseudoinverse implementation.\n\n# beta_scratch contains all learned parameters:\n# beta_scratch[0]  -> intercept\n# beta_scratch[1:] -> feature coefficients\n#\n# We separate them here so they can be compared directly\n# with sklearn's intercept_ and coef_ attributes.\n\nintercept_scratch = beta_scratch[0]\ncoefficients_scratch = beta_scratch[1:]\n\n# Create a table so we can compare every feature's coefficient.\ncoefficient_comparison = pd.DataFrame({\n    \"Feature\": feature_names,\n    \"Sklearn\": linear_regression_model.coef_,\n    \"From Scratch\": coefficients_scratch\n})\n\n# Calculate the numerical difference between the two implementations.\n# Ideally, these differences should be extremely close to zero.\ncoefficient_comparison[\"Difference\"] = (\n    coefficient_comparison[\"Sklearn\"]\n    - coefficient_comparison[\"From Scratch\"]\n)\n\nprint(\"===== COEFFICIENT COMPARISON =====\")\nprint(coefficient_comparison.to_string(index=False))\n\nprint(\"\\n===== INTERCEPT COMPARISON =====\")\nprint(f\"Sklearn:       {linear_regression_model.intercept_}\")\nprint(f\"From Scratch:  {intercept_scratch}\")\n\nprint(\"\\n===== MAXIMUM COEFFICIENT DIFFERENCE =====\")\nprint(\n    np.max(\n        np.abs(\n            linear_regression_model.coef_\n            - coefficients_scratch\n        )\n    )\n)\n\nprint(\"\\n===== INTERCEPT DIFFERENCE =====\")\nprint(\n    abs(\n        linear_regression_model.intercept_\n        - intercept_scratch\n    )\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-02T12:54:30.678006Z","iopub.execute_input":"2026-10-02T12:54:30.678973Z","iopub.status.idle":"2026-10-02T12:54:30.689893Z","shell.execute_reply.started":"2026-10-02T12:54:30.678941Z","shell.execute_reply":"2026-10-02T12:54:30.689164Z"}},"outputs":[{"name":"stdout","text":"===== COEFFICIENT COMPARISON =====\n                                     Feature       Sklearn  From Scratch    Difference\n                    categorical__mainroad_no -1.839600e+05  3.855131e+03 -1.878151e+05\n                   categorical__mainroad_yes  1.839600e+05  3.717751e+05 -1.878151e+05\n                   categorical__guestroom_no -1.158050e+05  7.201009e+04 -1.878151e+05\n                  categorical__guestroom_yes  1.158050e+05  3.036201e+05 -1.878151e+05\n                    categorical__basement_no -1.951256e+05 -7.310484e+03 -1.878151e+05\n                   categorical__basement_yes  1.951256e+05  3.829407e+05 -1.878151e+05\n             categorical__hotwaterheating_no -3.423249e+05 -1.545098e+05 -1.878151e+05\n            categorical__hotwaterheating_yes  3.423249e+05  5.301400e+05 -1.878151e+05\n             categorical__airconditioning_no -3.957134e+05 -2.078983e+05 -1.878151e+05\n            categorical__airconditioning_yes  3.957134e+05  5.835285e+05 -1.878151e+05\n                    categorical__prefarea_no -3.149453e+05 -1.271302e+05 -1.878151e+05\n                   categorical__prefarea_yes  3.149453e+05  5.027604e+05 -1.878151e+05\n     categorical__furnishingstatus_furnished  1.801756e+05  3.053857e+05 -1.252101e+05\ncategorical__furnishingstatus_semi-furnished  5.329381e+04  1.785039e+05 -1.252101e+05\n   categorical__furnishingstatus_unfurnished -2.334694e+05 -1.082594e+05 -1.252101e+05\n                             remainder__area  2.359688e+02  2.359688e+02 -9.259793e-11\n                         remainder__bedrooms  7.677870e+04  7.677870e+04  5.529728e-10\n                        remainder__bathrooms  1.094445e+06  1.094445e+06  6.984919e-10\n                          remainder__stories  4.074766e+05  4.074766e+05 -1.164153e-09\n                          remainder__parking  2.248419e+05  2.248419e+05  5.529728e-10\n\n===== INTERCEPT COMPARISON =====\nSklearn:       1627730.9047691296\nFrom Scratch:  375630.2087928748\n\n===== MAXIMUM COEFFICIENT DIFFERENCE =====\n187815.10439645557\n\n===== INTERCEPT DIFFERENCE =====\n1252100.6959762548\n","output_type":"stream"}],"execution_count":56},{"cell_type":"markdown","source":"1. 8.1 — Understand the problem with ordinary Linear Regression\n2. 8.2 — Understand Regularization\n3. 8.3 — Ridge Regression\n4. 8.4 — Train Ridge\n5. 8.5 — Evaluate Ridge\n6. 8.6 — Compare Linear Regression vs Ridge\n7. 8.7 — Lasso Regression\n8. 8.8 — Train Lasso\n9. 8.9 — Evaluate Lasso\n10. 8.10 — Compare all three models\n11. 8.11 — Inspect Ridge/Lasso coefficients\n12. 8.12 — Understand what changed\nThe important idea is:","metadata":{}},{"cell_type":"code","source":"# ============================================================\n# STEP 8 — RIDGE & LASSO REGRESSION\n# COMPLETE STEP — REGULARIZATION\n# ============================================================\n\n# OBJECTIVE:\n# Understand and implement Ridge and Lasso Regression as extensions\n# of ordinary Linear Regression. We will:\n#\n# 8.1  Understand why regularization is needed\n# 8.2  Build preprocessing for Ridge/Lasso\n# 8.3  Train Ridge Regression\n# 8.4  Evaluate Ridge\n# 8.5  Compare Linear Regression vs Ridge\n# 8.6  Train Lasso Regression\n# 8.7  Evaluate Lasso\n# 8.8  Compare all three models\n# 8.9  Inspect Ridge coefficients\n# 8.10 Inspect Lasso coefficients\n# 8.11 Count coefficients driven close to zero\n# 8.12 Visualize coefficient magnitudes\n#\n# IMPORTANT:\n# Ridge and Lasso are regularized versions of Linear Regression.\n#\n# Ridge uses L2 regularization:\n#\n#     Loss = MSE + alpha * sum(beta_j^2)\n#\n# Lasso uses L1 regularization:\n#\n#     Loss = MSE + alpha * sum(|beta_j|)\n#\n# Ridge generally shrinks coefficients toward zero.\n# Lasso can shrink some coefficients exactly to zero.\n\n\n# ============================================================\n# 8.1 — IMPORT REQUIRED LIBRARIES\n# ============================================================\n\n# OBJECTIVE:\n# Import every library required for preprocessing, training,\n# evaluation, visualization, and coefficient analysis.\n\nimport numpy as np\nimport pandas as pd\nimport matplotlib.pyplot as plt\n\nfrom sklearn.compose import ColumnTransformer\nfrom sklearn.preprocessing import OneHotEncoder, StandardScaler\n\nfrom sklearn.linear_model import Ridge, Lasso\n\nfrom sklearn.metrics import (\n    mean_absolute_error,\n    mean_squared_error,\n    r2_score\n)\n\n\n# ============================================================\n# 8.2 — VERIFY REQUIRED VARIABLES FROM PREVIOUS STEPS\n# ============================================================\n\n# OBJECTIVE:\n# Make sure the variables created during the earlier project steps\n# are available before starting Ridge and Lasso.\n#\n# We need:\n#\n# X              -> complete feature DataFrame\n# y              -> target variable\n# X_train        -> training features\n# X_test         -> testing features\n# y_train        -> training target\n# y_test         -> testing target\n#\n# numerical_features and categorical_features were created during\n# our preprocessing stage.\n\nrequired_variables = [\n    \"X\",\n    \"y\",\n    \"X_train\",\n    \"X_test\",\n    \"y_train\",\n    \"y_test\",\n    \"numerical_features\",\n    \"categorical_features\"\n]\n\nmissing_variables = [\n    variable\n    for variable in required_variables\n    if variable not in globals()\n]\n\nif missing_variables:\n    raise NameError(\n        \"The following variables are missing: \"\n        + \", \".join(missing_variables)\n        + \". Please run the previous project steps first.\"\n    )\n\nprint(\"===== REQUIRED VARIABLES CHECK =====\")\nprint(\"All required variables are available.\")\n\n\n# ============================================================\n# 8.3 — BUILD PREPROCESSING PIPELINE FOR RIDGE/LASSO\n# ============================================================\n\n# OBJECTIVE:\n# Prepare the features specifically for regularized regression.\n#\n# Numerical features will be standardized because Ridge and Lasso\n# penalize coefficient magnitudes. Without scaling, features with\n# different units can receive unfairly different regularization.\n#\n# Categorical features will be converted into numerical columns\n# using One-Hot Encoding.\n#\n# We fit the preprocessing ONLY on X_train to prevent test-set\n# information from leaking into the training process.\n\nridge_lasso_preprocessor = ColumnTransformer(\n    transformers=[\n        \n        # Standardize numerical features:\n        #\n        # z = (x - mean) / standard_deviation\n        #\n        # This makes numerical features roughly comparable in scale.\n        (\n            \"numerical\",\n            StandardScaler(),\n            numerical_features\n        ),\n        \n        # Convert categorical variables into numerical 0/1 columns.\n        #\n        # handle_unknown=\"ignore\" prevents errors if a category appears\n        # in X_test that was not present in X_train.\n        (\n            \"categorical\",\n            OneHotEncoder(handle_unknown=\"ignore\"),\n            categorical_features\n        )\n    ]\n)\n\n\n# Fit preprocessing only on the training data.\nridge_lasso_preprocessor.fit(X_train)\n\n# Transform the training features.\nX_train_regularized = ridge_lasso_preprocessor.transform(X_train)\n\n# Transform the test features using the SAME fitted transformer.\nX_test_regularized = ridge_lasso_preprocessor.transform(X_test)\n\n# Retrieve the names of all transformed features.\nregularized_feature_names = (\n    ridge_lasso_preprocessor.get_feature_names_out()\n)\n\nprint(\"\\n===== REGULARIZED PREPROCESSING =====\")\nprint(\"Original feature count:\", X_train.shape[1])\nprint(\"Processed feature count:\", X_train_regularized.shape[1])\n\nprint(\"\\n===== PROCESSED FEATURES =====\")\nprint(regularized_feature_names)\n\n\n# ============================================================\n# 8.4 — TRAIN RIDGE REGRESSION\n# ============================================================\n\n# OBJECTIVE:\n# Train Ridge Regression with alpha = 1.0.\n#\n# alpha controls the strength of L2 regularization:\n#\n#     Small alpha -> weak regularization\n#     Large alpha -> strong regularization\n#\n# Ridge adds a penalty on the squared coefficient values:\n#\n#     alpha * sum(beta_j^2)\n#\n# This discourages very large coefficients.\n\nridge_model = Ridge(alpha=1.0)\n\n# Fit Ridge on the training data.\nridge_model.fit(\n    X_train_regularized,\n    y_train\n)\n\nprint(\"\\n===== RIDGE MODEL TRAINED =====\")\nprint(\"Alpha:\", ridge_model.alpha)\nprint(\"Number of coefficients:\", len(ridge_model.coef_))\nprint(\"Intercept:\", ridge_model.intercept_)\n\n\n# ============================================================\n# 8.5 — GENERATE RIDGE PREDICTIONS\n# ============================================================\n\n# OBJECTIVE:\n# Use the trained Ridge model to predict house prices for the\n# unseen test dataset.\n\ny_pred_ridge = ridge_model.predict(\n    X_test_regularized\n)\n\nprint(\"\\n===== RIDGE PREDICTIONS =====\")\nprint(\"Number of predictions:\", len(y_pred_ridge))\n\n# Display a few actual vs predicted values.\nridge_prediction_comparison = pd.DataFrame({\n    \"Actual Price\": y_test.values,\n    \"Predicted Price\": y_pred_ridge\n})\n\nridge_prediction_comparison[\"Error\"] = (\n    ridge_prediction_comparison[\"Actual Price\"]\n    - ridge_prediction_comparison[\"Predicted Price\"]\n)\n\nridge_prediction_comparison[\"Absolute Error\"] = (\n    np.abs(ridge_prediction_comparison[\"Error\"])\n)\n\nprint(\n    ridge_prediction_comparison.head(10).to_string(index=False)\n)\n\n\n# ============================================================\n# 8.6 — EVALUATE RIDGE REGRESSION\n# ============================================================\n\n# OBJECTIVE:\n# Calculate MAE, MSE, RMSE and R² for Ridge.\n#\n# MAE:\n# Average absolute prediction error.\n#\n# MSE:\n# Average squared prediction error.\n#\n# RMSE:\n# Square root of MSE, expressed in the same unit as price.\n#\n# R²:\n# Measures the proportion of target variance explained by the model.\n\nmae_ridge = mean_absolute_error(\n    y_test,\n    y_pred_ridge\n)\n\nmse_ridge = mean_squared_error(\n    y_test,\n    y_pred_ridge\n)\n\nrmse_ridge = np.sqrt(\n    mse_ridge\n)\n\nr2_ridge = r2_score(\n    y_test,\n    y_pred_ridge\n)\n\nprint(\"\\n===== RIDGE REGRESSION EVALUATION =====\")\nprint(f\"MAE:   ₹{mae_ridge:,.2f}\")\nprint(f\"MSE:   {mse_ridge:,.2f}\")\nprint(f\"RMSE:  ₹{rmse_ridge:,.2f}\")\nprint(f\"R²:    {r2_ridge:.6f}\")\n\n\n# ============================================================\n# 8.7 — TRAIN LASSO REGRESSION\n# ============================================================\n\n# OBJECTIVE:\n# Train Lasso Regression using L1 regularization.\n#\n# Lasso adds:\n#\n#     alpha * sum(|beta_j|)\n#\n# to the loss function.\n#\n# One important property of Lasso is that it can push some\n# coefficients exactly to zero, which can perform a form of\n# automatic feature selection.\n#\n# max_iter=10000 gives the optimization algorithm more iterations\n# so it has enough opportunity to converge.\n\nlasso_model = Lasso(\n    alpha=1.0,\n    max_iter=10000\n)\n\n# Train Lasso on the same regularized training representation.\nlasso_model.fit(\n    X_train_regularized,\n    y_train\n)\n\nprint(\"\\n===== LASSO MODEL TRAINED =====\")\nprint(\"Alpha:\", lasso_model.alpha)\nprint(\"Number of coefficients:\", len(lasso_model.coef_))\nprint(\"Intercept:\", lasso_model.intercept_)\n\n\n# ============================================================\n# 8.8 — GENERATE LASSO PREDICTIONS\n# ============================================================\n\n# OBJECTIVE:\n# Generate house-price predictions using the trained Lasso model.\n\ny_pred_lasso = lasso_model.predict(\n    X_test_regularized\n)\n\nlasso_prediction_comparison = pd.DataFrame({\n    \"Actual Price\": y_test.values,\n    \"Predicted Price\": y_pred_lasso\n})\n\nlasso_prediction_comparison[\"Error\"] = (\n    lasso_prediction_comparison[\"Actual Price\"]\n    - lasso_prediction_comparison[\"Predicted Price\"]\n)\n\nlasso_prediction_comparison[\"Absolute Error\"] = (\n    np.abs(lasso_prediction_comparison[\"Error\"])\n)\n\nprint(\"\\n===== LASSO PREDICTIONS =====\")\nprint(\n    lasso_prediction_comparison.head(10).to_string(index=False)\n)\n\n\n# ============================================================\n# 8.9 — EVALUATE LASSO REGRESSION\n# ============================================================\n\n# OBJECTIVE:\n# Calculate the same evaluation metrics for Lasso so that we can\n# make a fair comparison with Linear Regression and Ridge.\n\nmae_lasso = mean_absolute_error(\n    y_test,\n    y_pred_lasso\n)\n\nmse_lasso = mean_squared_error(\n    y_test,\n    y_pred_lasso\n)\n\nrmse_lasso = np.sqrt(\n    mse_lasso\n)\n\nr2_lasso = r2_score(\n    y_test,\n    y_pred_lasso\n)\n\nprint(\"\\n===== LASSO REGRESSION EVALUATION =====\")\nprint(f\"MAE:   ₹{mae_lasso:,.2f}\")\nprint(f\"MSE:   {mse_lasso:,.2f}\")\nprint(f\"RMSE:  ₹{rmse_lasso:,.2f}\")\nprint(f\"R²:    {r2_lasso:.6f}\")\n\n\n# ============================================================\n# 8.10 — CREATE BASELINE LINEAR REGRESSION RESULTS\n# ============================================================\n\n# OBJECTIVE:\n# Recalculate the ordinary Linear Regression metrics so that\n# all three models can be placed into one comparison table.\n#\n# y_pred comes from our original sklearn Linear Regression model\n# trained before regularization.\n\nlinear_mae = mean_absolute_error(\n    y_test,\n    y_pred\n)\n\nlinear_mse = mean_squared_error(\n    y_test,\n    y_pred\n)\n\nlinear_rmse = np.sqrt(\n    linear_mse\n)\n\nlinear_r2 = r2_score(\n    y_test,\n    y_pred\n)\n\n\n# ============================================================\n# 8.11 — COMPARE LINEAR REGRESSION, RIDGE AND LASSO\n# ============================================================\n\n# OBJECTIVE:\n# Compare all three approaches using the exact same test set\n# and the same evaluation metrics.\n#\n# Lower MAE/MSE/RMSE is generally better.\n# Higher R² is generally better.\n#\n# We will not blindly declare a winner here. The purpose is to\n# understand how regularization changes model behavior.\n\nmodel_comparison = pd.DataFrame({\n    \"Model\": [\n        \"Linear Regression\",\n        \"Ridge Regression\",\n        \"Lasso Regression\"\n    ],\n    \n    \"MAE\": [\n        linear_mae,\n        mae_ridge,\n        mae_lasso\n    ],\n    \n    \"MSE\": [\n        linear_mse,\n        mse_ridge,\n        mse_lasso\n    ],\n    \n    \"RMSE\": [\n        linear_rmse,\n        rmse_ridge,\n        rmse_lasso\n    ],\n    \n    \"R²\": [\n        linear_r2,\n        r2_ridge,\n        r2_lasso\n    ]\n})\n\nprint(\"\\n===== COMPLETE MODEL COMPARISON =====\")\nprint(\n    model_comparison.to_string(index=False)\n)\n\n\n# ============================================================\n# 8.12 — INSPECT RIDGE COEFFICIENTS\n# ============================================================\n\n# OBJECTIVE:\n# Examine the coefficients learned by Ridge.\n#\n# Ridge attempts to keep coefficients smaller by adding the\n# L2 penalty. The coefficient values therefore help us see\n# the direct effect of regularization.\n\nridge_coefficient_table = pd.DataFrame({\n    \"Feature\": regularized_feature_names,\n    \"Coefficient\": ridge_model.coef_\n})\n\n# Add absolute coefficient magnitude so that we can easily\n# identify the features with the strongest coefficient values.\nridge_coefficient_table[\"Absolute Coefficient\"] = (\n    np.abs(ridge_coefficient_table[\"Coefficient\"])\n)\n\nridge_coefficient_table = (\n    ridge_coefficient_table\n    .sort_values(\n        by=\"Absolute Coefficient\",\n        ascending=False\n    )\n)\n\nprint(\"\\n===== RIDGE COEFFICIENTS =====\")\nprint(\n    ridge_coefficient_table.to_string(index=False)\n)\n\n\n# ============================================================\n# 8.13 — INSPECT LASSO COEFFICIENTS\n# ============================================================\n\n# OBJECTIVE:\n# Examine the coefficients learned by Lasso and identify which\n# features were strongly reduced or completely eliminated.\n\nlasso_coefficient_table = pd.DataFrame({\n    \"Feature\": regularized_feature_names,\n    \"Coefficient\": lasso_model.coef_\n})\n\n# Calculate absolute coefficient magnitude.\nlasso_coefficient_table[\"Absolute Coefficient\"] = (\n    np.abs(lasso_coefficient_table[\"Coefficient\"])\n)\n\nlasso_coefficient_table = (\n    lasso_coefficient_table\n    .sort_values(\n        by=\"Absolute Coefficient\",\n        ascending=False\n    )\n)\n\nprint(\"\\n===== LASSO COEFFICIENTS =====\")\nprint(\n    lasso_coefficient_table.to_string(index=False)\n)\n\n\n# ============================================================\n# 8.14 — COUNT LASSO ZERO COEFFICIENTS\n# ============================================================\n\n# OBJECTIVE:\n# Determine how many feature coefficients Lasso pushed exactly\n# to zero.\n#\n# A zero coefficient means that the corresponding feature does\n# not contribute directly to the final Lasso prediction under\n# this particular alpha value and dataset.\n\nlasso_zero_coefficients = np.sum(\n    lasso_model.coef_ == 0\n)\n\ntotal_lasso_coefficients = len(\n    lasso_model.coef_\n)\n\nprint(\"\\n===== LASSO FEATURE SELECTION =====\")\nprint(\n    \"Total coefficients:\",\n    total_lasso_coefficients\n)\n\nprint(\n    \"Zero coefficients:\",\n    lasso_zero_coefficients\n)\n\nprint(\n    \"Non-zero coefficients:\",\n    total_lasso_coefficients\n    - lasso_zero_coefficients\n)\n\n\n# ============================================================\n# 8.15 — COMPARE COEFFICIENT MAGNITUDES\n# ============================================================\n\n# OBJECTIVE:\n# Compare the absolute coefficient sizes produced by Ridge\n# and Lasso.\n#\n# We use absolute values because the sign tells us the direction\n# of the relationship, while the absolute value tells us the\n# magnitude of the coefficient.\n\ncoefficient_magnitude_comparison = pd.DataFrame({\n    \"Feature\": regularized_feature_names,\n    \"Ridge |Coefficient|\": np.abs(ridge_model.coef_),\n    \"Lasso |Coefficient|\": np.abs(lasso_model.coef_)\n})\n\ncoefficient_magnitude_comparison[\"Ridge |Coefficient|\"] = (\n    coefficient_magnitude_comparison[\"Ridge |Coefficient|\"]\n    .round(4)\n)\n\ncoefficient_magnitude_comparison[\"Lasso |Coefficient|\"] = (\n    coefficient_magnitude_comparison[\"Lasso |Coefficient|\"]\n    .round(4)\n)\n\nprint(\"\\n===== COEFFICIENT MAGNITUDE COMPARISON =====\")\nprint(\n    coefficient_magnitude_comparison\n    .sort_values(\n        by=\"Ridge |Coefficient|\",\n        ascending=False\n    )\n    .to_string(index=False)\n)\n\n\n# ============================================================\n# 8.16 — ACTUAL VS PREDICTED: RIDGE\n# ============================================================\n\n# OBJECTIVE:\n# Visualize how closely Ridge predictions follow the actual\n# house prices.\n\nplt.figure(figsize=(8, 6))\n\nplt.scatter(\n    y_test,\n    y_pred_ridge,\n    alpha=0.7\n)\n\n# Create a diagonal reference line.\n# Perfect predictions would lie on this line.\nminimum_price = min(\n    y_test.min(),\n    y_pred_ridge.min()\n)\n\nmaximum_price = max(\n    y_test.max(),\n    y_pred_ridge.max()\n)\n\nplt.plot(\n    [minimum_price, maximum_price],\n    [minimum_price, maximum_price],\n    linestyle=\"--\"\n)\n\nplt.xlabel(\"Actual Price\")\nplt.ylabel(\"Predicted Price\")\nplt.title(\"Ridge Regression — Actual vs Predicted\")\n\nplt.show()\n\n\n# ============================================================\n# 8.17 — ACTUAL VS PREDICTED: LASSO\n# ============================================================\n\n# OBJECTIVE:\n# Visualize how closely Lasso predictions follow the actual\n# house prices.\n\nplt.figure(figsize=(8, 6))\n\nplt.scatter(\n    y_test,\n    y_pred_lasso,\n    alpha=0.7\n)\n\nminimum_price = min(\n    y_test.min(),\n    y_pred_lasso.min()\n)\n\nmaximum_price = max(\n    y_test.max(),\n    y_pred_lasso.max()\n)\n\nplt.plot(\n    [minimum_price, maximum_price],\n    [minimum_price, maximum_price],\n    linestyle=\"--\"\n)\n\nplt.xlabel(\"Actual Price\")\nplt.ylabel(\"Predicted Price\")\nplt.title(\"Lasso Regression — Actual vs Predicted\")\n\nplt.show()\n\n\n# ============================================================\n# 8.18 — FINAL SUMMARY\n# ============================================================\n\n# OBJECTIVE:\n# Print a compact summary of everything we learned from this\n# regularization experiment.\n\nprint(\"\\n\")\nprint(\"=\" * 65)\nprint(\"STEP 8 — REGULARIZATION SUMMARY\")\nprint(\"=\" * 65)\n\nprint(\"\\n1. Linear Regression\")\nprint(f\"   RMSE: ₹{linear_rmse:,.2f}\")\nprint(f\"   R²:   {linear_r2:.6f}\")\n\nprint(\"\\n2. Ridge Regression\")\nprint(f\"   Alpha: {ridge_model.alpha}\")\nprint(f\"   RMSE:  ₹{rmse_ridge:,.2f}\")\nprint(f\"   R²:    {r2_ridge:.6f}\")\n\nprint(\"\\n3. Lasso Regression\")\nprint(f\"   Alpha: {lasso_model.alpha}\")\nprint(f\"   RMSE:  ₹{rmse_lasso:,.2f}\")\nprint(f\"   R²:    {r2_lasso:.6f}\")\n\nprint(\"\\n4. Lasso Feature Selection\")\nprint(f\"   Total coefficients: {total_lasso_coefficients}\")\nprint(f\"   Zero coefficients:  {lasso_zero_coefficients}\")\nprint(\n    f\"   Non-zero coefficients: \"\n    f\"{total_lasso_coefficients - lasso_zero_coefficients}\"\n)\n\nprint(\"\\n\" + \"=\" * 65)\nprint(\"STEP 8 COMPLETE\")\nprint(\"=\" * 65)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-02T12:57:04.957038Z","iopub.execute_input":"2026-10-02T12:57:04.957557Z","iopub.status.idle":"2026-10-02T12:57:05.337253Z","shell.execute_reply.started":"2026-10-02T12:57:04.957516Z","shell.execute_reply":"2026-10-02T12:57:05.336209Z"}},"outputs":[{"name":"stdout","text"